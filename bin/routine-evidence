#!/usr/bin/env bash
# routine-script: routine-evidence
# routine-description: Print a committable snapshot of run state — the retro relayed verbatim, never recomputed
# routine-exit: 0 — the snapshot is printed
# routine-test: test/evidence.bats
#
#   bin/routine-evidence > evidence/retro.txt
#
# runs/ is gitignored, so nobody reviewing this repository can see that a
# run ever happened — a whole council once asserted none had, while a
# concluded one sat on disk. This renders what the scripts measured into
# something committable, so judgments read measurements instead of
# assuming them.
#
# It relays bin/routine-retro and recomputes nothing: two derivations of
# one number drift, and that lesson cost a reverted change. Freshness is
# not claimed — runs/ is absent in CI, so no check can prove this current;
# the header's timestamp is the honest statement of when it was true.
set -u

bindir="$(cd "$(dirname "$0")" && pwd)"
libdir="$(cd "$(dirname "$0")/.." && pwd)/lib"
# shellcheck source=/dev/null
. "$libdir/paths.sh"
# shellcheck source=/dev/null
. "$libdir/corpus.sh"

# The corpus is counted from the same globs routine-retro reads, so the
# declaration can never name a corpus the body did not come from. It is
# a count of files, not a second derivation of any measurement.
corpus_count="$(routine_telemetry_files "$(routine_root)" | wc -l | tr -d ' ')"
if [ "$corpus_count" -eq 0 ]; then
  corpus="none — no telemetry under runs/, so this render decides nothing"
else
  corpus="$corpus_count telemetry file(s) under runs/"
fi

echo "# generated by bin/routine-evidence at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo "# a verbatim render of bin/routine-retro over this machine's runs/"
echo "# corpus: $corpus"
echo "# never edit by hand: regenerate with bin/routine-evidence > evidence/retro.txt"
echo
exec "$bindir/routine-retro"
