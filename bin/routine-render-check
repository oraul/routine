#!/usr/bin/env bash
# routine-script: routine-render-check
# routine-description: Refuse a committed render that disagrees with what its own declared generator produces now, naming the render and the command that refreshes it
# routine-usage: routine-render-check <file> [file...]
# routine-exit: 0 — every named render agrees with its generator, or could not be decided
# routine-exit: 1 — a render disagrees with its generator, or names a generator that will not be run
# routine-exit: 2 — usage — at least one readable file argument is required
# routine-test: test/render_check.bats
# A render describes how to check itself. Its first line declares the
# generator that made it, so this script re-runs that generator and
# compares — it needs no list of which files are renders and no
# knowledge of what any particular render contains.
#
# Three decisions carry the whole design:
#
#   - The generator's own timestamp line is excluded from the
#     comparison. It differs by construction on every run, so including
#     it would refuse every render always: a tripwire, not a gate.
#   - A header is data in a file, and running whatever it names would
#     let a file run any command. Only a repo-local bin/routine-* script
#     is executed; anything else is refused unrun.
#   - A render may declare the corpus it derives from. Where that corpus
#     matches no file, nothing can be regenerated, so the render is
#     reported undecided rather than blessed or refused — runs/ is
#     gitignored, and this script runs in CI on a checkout that has none.
#
# It never regenerates what it judges: a gate that repairs its subject
# has judged nothing.
set -u

lib="$(cd "$(dirname "$0")/.." && pwd)/lib"
# shellcheck source=/dev/null
. "$lib/paths.sh"
# shellcheck source=/dev/null
. "$lib/telemetry.sh"

start_ms="$(routine_now_ms)"

emit_and_exit() {
  telemetry_harness_emit harness.render bin/routine-render-check "$1" \
    "$(( $(routine_now_ms) - start_ms ))"
  exit "$1"
}

if [ "$#" -eq 0 ]; then
  echo "usage: routine-render-check <file> [file...]" >&2
  emit_and_exit 2
fi
for file in "$@"; do
  if [ ! -f "$file" ] || [ ! -r "$file" ]; then
    echo "usage: routine-render-check <file> [file...]" >&2
    emit_and_exit 2
  fi
done

fails=0

for file in "$@"; do
  header="$(head -n 1 "$file")"

  # Not a render: no generator declared, so there is nothing to check.
  case "$header" in
    "# generated by "*) ;;
    *) continue ;;
  esac

  generator="$(printf '%s' "$header" | sed -n 's/^# generated by \(.*\) at .*$/\1/p')"
  if [ -z "$generator" ]; then
    generator="$(printf '%s' "$header" | sed -n 's/^# generated by \(.*\)$/\1/p')"
  fi

  # The render's repository is derived from where the render sits
  # (evidence/<name> under the root), never from this script's own
  # location, so a fixture render is checked against its own tree.
  root="$(cd "$(dirname "$file")/.." && pwd)"

  # A generator is run only when it is a repo-local bin/routine-* script.
  case "$generator" in
    bin/routine-*)
      case "$generator" in
        *..*)
          echo "render-check: $file: generator escapes the repository: $generator" >&2
          fails=$((fails + 1)); continue ;;
        *) ;;
      esac
      ;;
    *)
      echo "render-check: $file: generator is not a repo-local bin/routine-* script: $generator" >&2
      fails=$((fails + 1))
      continue
      ;;
  esac

  if [ ! -x "$root/$generator" ]; then
    echo "render-check: $file: generator is not an executable in this repository: $generator" >&2
    fails=$((fails + 1))
    continue
  fi

  # A declared corpus decides whether this render can be judged at all.
  corpus="$(sed -n 's/^# corpus: //p' "$file" | head -n 1)"
  if [ -n "$corpus" ]; then
    case "$corpus" in
      /*|*..*)
        echo "render-check: $file: declared corpus escapes the repository: $corpus" >&2
        fails=$((fails + 1))
        continue
        ;;
      *) ;;
    esac
    matches=0
    # Deliberate word splitting: the declared corpus is a pattern, and
    # expanding it inside the render's own root is the whole point.
    # shellcheck disable=SC2086
    for candidate in $(cd "$root" && printf '%s\n' $corpus); do
      [ -e "$root/$candidate" ] && matches=$((matches + 1))
    done
    if [ "$matches" -eq 0 ]; then
      echo "render-check: $file: not decided — declared corpus matches no file: $corpus"
      continue
    fi
  fi

  fresh="$(mktemp)"
  if ! ( cd "$root" && "./$generator" ) > "$fresh" 2>/dev/null; then
    rm -f "$fresh"
    echo "render-check: $file: generator failed: $generator" >&2
    fails=$((fails + 1))
    continue
  fi

  # Everything but the generator's own timestamp line is compared.
  if ! diff -q \
    <(grep -v '^# generated by ' "$file") \
    <(grep -v '^# generated by ' "$fresh") > /dev/null 2>&1
  then
    echo "render-check: $file: stale — refresh with: $generator > $file" >&2
    fails=$((fails + 1))
  fi
  rm -f "$fresh"
done

if [ "$fails" -ne 0 ]; then
  emit_and_exit 1
fi
emit_and_exit 0
