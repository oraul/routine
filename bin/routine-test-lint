#!/usr/bin/env bash
# routine-script: routine-test-lint
# routine-description: A test names the claim it defends and its body proves it — the naming gate and the expectation gate
# routine-usage: routine-test-lint [test-dir] (defaults to the repo's test/)
# routine-exit: 0 — every name states a claim and every body proves it
# routine-exit: 1 — a name or a body violates a rule — the output names file, test and rule family
# routine-exit: 2 — usage — the test directory does not exist
# routine-test: test/test_lint.bats
# A test name is the only part of a suite most readers ever read, so it
# carries the claim. Every threshold below was measured against this
# repository's own corpus before it was written: no name opens with a
# mechanism word, the shortest is three words, the longest 83 characters,
# and no suite repeats a name. A bats test also passes when its last
# command exits 0, so a body that never touches a recognised expectation
# token can never fail and defends no claim either. This lint pins both,
# it does not clean up.
#
# Every rule below is judged inside one awk pass per suite file, never in
# shell: a per-test pipeline (measured at ~15 launches per test, 6,902 for
# this repository's 446 tests) pays per-file cost per test. The same
# checks inside one awk process cost milliseconds. The shell keeps only
# the walk, the violation tally, the usage check and the exact summary
# strings — everything else moved into the awk program below.
set -u

lib="$(cd "$(dirname "$0")/.." && pwd)/lib"
# shellcheck source=/dev/null
. "$lib/paths.sh"
# shellcheck source=/dev/null
. "$lib/telemetry.sh"

start_ms="$(routine_now_ms)"

emit_and_exit() {
  telemetry_harness_emit harness.test bin/routine-test-lint "$1" \
    "$(( $(routine_now_ms) - start_ms ))"
  exit "$1"
}

root="$(routine_root)"
dir="${1:-$root/test}"

if [ ! -d "$dir" ]; then
  echo "usage: routine-test-lint [test-dir] (defaults to the repo's test/)" >&2
  emit_and_exit 2
fi

# An opener plus a literal space, never a word boundary: \b is absent from
# BSD grep (and from awk's ERE dialect too), and a boundary match refuses
# `testing/tdd ...`, which is a caffeine topic path rather than the word
# "testing". awk has no case-insensitive match flag, so the name side is
# lowered with tolower() and matched against this already-lowercase list.
openers='test|tests|testing|check|checks|verify|verifies|should|it|ensure|ensures|can|will|does|works|handles|correctly'

violations=0

# Everything that used to be a shell pipeline per name and per body line
# now runs inside this one awk program per file. It extracts names and
# bodies exactly as the old extraction pass did (brace-depth counting,
# never a shell parse of the body), then judges every rule against the
# arrays it just built: naming (opener, word count, length), duplicates,
# the expectation-token body rule, the pairing rule and the isolation
# rule. Violation lines print in the same order the shell produced them
# in: naming rules in declaration order, then duplicates, then per test
# body -> pairing -> isolation in test order. The program is passed
# straight to awk as its own argument, never through an intermediate
# shell variable, so its many literal $0/$1-style tokens are never
# mistaken by shellcheck for shell expansions that should have used
# double quotes.
for file in "$dir"/*.bats; do
  [ -f "$file" ] || continue

  out="$(awk -v openers="$openers" -v SQ="'" '
BEGIN { n = 0; depth = 0 }

# Extraction: the name is between the first quote and the last quote
# before the opening brace, on the @test line itself; the body is
# everything up to the matching close brace, tracked by counting braces
# rather than by parsing shell. A body spanning several lines, or several
# tests sharing one line, still yields the right span.
depth == 0 && /^@test[ \t]/ {
  qstart = index($0, "\"")
  bpos = index($0, "{")
  if (qstart == 0 || bpos == 0) { next }
  upto = substr($0, 1, bpos - 1)
  lastq = 0
  for (k = length(upto); k > qstart; k--) {
    if (substr(upto, k, 1) == "\"") { lastq = k; break }
  }
  if (lastq == 0) { next }
  n++
  names[n] = substr($0, qstart + 1, lastq - qstart - 1)
  rc[n] = 0
  seg = substr($0, bpos)
  depth = 0
  for (k = 1; k <= length(seg); k++) {
    c = substr(seg, k, 1)
    if (c == "{") { depth++ }
    else if (c == "}") { depth-- }
  }
  rest = substr(seg, 2)
  if (length(rest) > 0) {
    rc[n]++
    rawline[n, rc[n]] = rest
  }
  next
}

depth > 0 {
  for (k = 1; k <= length($0); k++) {
    c = substr($0, k, 1)
    if (c == "{") { depth++ }
    else if (c == "}") { depth-- }
  }
  rc[n]++
  rawline[n, rc[n]] = $0
  next
}

# The pairing gate: `! grep -q X "$doc"` passes when $doc does not exist,
# and so does `! grep -rq X "$dir"/*/FILE.md` when the glob matches
# nothing. Neither has proved the forbidden thing absent rather than
# merely unlooked-at, so a negated grep is only trusted when the same
# body also asserts something positive about the same subject.
#
# The subject is the file/glob argument a negated grep line reads: the
# last shell word of the line, up to (but not through) a real unquoted
# pipe. A doubled pipe (||, the OR operator) is not a pipe boundary and is
# skipped so scanning continues past it; a single pipe (real command
# piping) ends the scan, since the file argument for the clause under
# test is whatever came before it. Quoting is tracked so a `|` living
# inside a quoted pattern (an alternation like admin|packages) is never
# mistaken for either.
function pairing_subject(line,    nlen, sq, dq, buf, lastword, stop, i, c, nc) {
  nlen = length(line)
  sq = 0; dq = 0
  buf = ""
  lastword = ""
  stop = 0
  i = 1
  while (i <= nlen && !stop) {
    c = substr(line, i, 1)
    if (sq) {
      if (c == SQ) sq = 0
      buf = buf c
      i++
      continue
    }
    if (dq) {
      if (c == "\"") dq = 0
      buf = buf c
      i++
      continue
    }
    if (c == SQ) { sq = 1; buf = buf c; i++; continue }
    if (c == "\"") { dq = 1; buf = buf c; i++; continue }
    if (c == "|") {
      nc = (i < nlen) ? substr(line, i + 1, 1) : ""
      if (nc == "|") {
        if (buf != "") { lastword = buf; buf = "" }
        i += 2
        continue
      }
      if (buf != "") { lastword = buf; buf = "" }
      stop = 1
      continue
    }
    if (c == " " || c == "\t") {
      if (buf != "") { lastword = buf; buf = "" }
      i++
      continue
    }
    buf = buf c
    i++
  }
  if (buf != "") lastword = buf
  return lastword
}

# A body line is a candidate negated-grep assertion when a `!` is
# followed by whitespace then the word "grep" — never anchored to line
# start, since the real corpus carries `[ ! -f X ] || ! grep -q Y X` as
# one line, and the bang guarding the grep sits mid-line. The bang may
# guard the grep directly, or guard a pipeline that ends in one; both are
# negated greps and both pass when the subject is empty or absent.
function is_negated_grep(line) {
  if (!(line ~ /! +[a-zA-Z_]/)) return 0
  if (index(line, "grep") == 0) return 0
  return 1
}

# The pairing gate escapes a subject the same way the sed call once did,
# character by character rather than one combined character class, so a
# backslash added for one character is never re-escaped by a later rule.
function escape_subject(s,    r) {
  r = s
  gsub(/\\/, "\\\\", r)
  gsub(/\[/, "\\[", r)
  gsub(/\]/, "\\]", r)
  gsub(/\./, "\\.", r)
  gsub(/\*/, "\\*", r)
  gsub(/\^/, "\\^", r)
  gsub(/\$/, "\\$", r)
  gsub(/\//, "\\/", r)
  return r
}

# A candidate protector line: names the same subject, carries some
# expectation token, and is not itself a negation of that same subject
# (another negated grep, or a negated unary test like `! -f`) — two
# negatives about one subject still prove nothing was ever looked at.
function is_positive_for_subject(line, subject,    esc) {
  if (index(line, subject) == 0) return 0

  # A body that BUILDS the subject has established it as surely as one
  # that asserts on it: a fixture write proves the file is there, so the
  # negation that follows cannot be reading an absence.
  esc = escape_subject(subject)
  if (line ~ ("(>>?|cp |mv |touch |mkdir |tee )[^|]*" esc)) return 1

  # An existence test pairs even when negated. `[ ! -f "$f" ] || ! grep -q
  # x "$f"` is the author handling vacuity on purpose — the disjunction
  # says "absent, or present without the forbidden thing", which is the
  # very distinction this rule exists to force.
  if (line ~ /\[ *!? *-[a-zA-Z] /) return 1

  if (!(index(line, "[ ") > 0 || index(line, "[[") > 0 || \
        index(line, "grep") > 0 || index(line, "diff ") > 0 || \
        index(line, "assert") > 0 || index(line, "refute") > 0 || \
        index(line, "-eq") > 0 || index(line, "-ne") > 0)) return 0
  if (is_negated_grep(line)) return 0
  if (line ~ /! +-[a-zA-Z]($|[^a-zA-Z])/) return 0
  return 1
}

# $output is exempt only when the body proves the command reached a known
# conclusion. bats always DEFINES $output after `run`; it does not always
# leave it NON-EMPTY. A crashed command leaves it empty, and a negated
# grep over an empty string passes — reporting the forbidden thing absent
# when in truth nothing ran. Asserting $status is what rules that out, so
# $status is the pairing partner for $output exactly as an existence test
# is for a file. jn/joined are the continuation-joined lines of the
# current test, populated by build_joined just before this is called.
function is_exempt_subject(subject, jn,    k) {
  if (subject != "\"$output\"" && subject != "$output") return 0
  for (k = 1; k <= jn; k++) {
    if (index(joined[k], "status") > 0) return 1
  }
  return 0
}

# A backslash continuation is one logical line wearing two physical ones.
# The corpus writes `! printf "%s" "$output" | awk "..." \` and puts the
# `| grep -q X` on the next line — scanned separately, neither half looks
# like a negated grep, and the rule would silently never see it. `joined`
# is a shared scratch array, rebuilt fresh for each test before use.
function build_joined(i,    k, jn, line, nxt) {
  jn = 0
  k = 1
  while (k <= rc[i]) {
    line = rawline[i, k]
    while (line ~ /\\[ \t]*$/ && k < rc[i]) {
      k++
      nxt = rawline[i, k]
      sub(/\\[ \t]*$/, "", line)
      sub(/^[ \t]+/, " ", nxt)
      line = line nxt
    }
    jn++
    joined[jn] = line
    k++
  }
  return jn
}

function has_expectation(i,    k, line) {
  for (k = 1; k <= rc[i]; k++) {
    line = rawline[i, k]
    if (index(line, "[ ") > 0) return 1
    if (index(line, "[[") > 0) return 1
    if (index(line, "status") > 0) return 1
    if (index(line, "output") > 0) return 1
    if (index(line, "grep") > 0) return 1
    if (index(line, "diff ") > 0) return 1
    if (index(line, "assert") > 0) return 1
    if (index(line, "refute") > 0) return 1
    if (index(line, "-eq") > 0) return 1
    if (index(line, "-ne") > 0) return 1
    if (index(line, "! ") > 0) return 1
  }
  return 0
}

function check_pairing(i,    jn, k, k2, pline, subj, other, paired) {
  jn = build_joined(i)
  for (k = 1; k <= jn; k++) {
    pline = joined[k]
    if (!is_negated_grep(pline)) continue
    subj = pairing_subject(pline)
    if (subj == "") continue
    if (is_exempt_subject(subj, jn)) continue

    # A line can pair itself. `[ ! -f "$f" ] || ! grep -q x "$f"` carries
    # both halves: the disjunction says "absent, or present without the
    # forbidden thing", which is precisely the distinction this rule
    # exists to force. Checked before the scan, which skips this line.
    if (pline ~ /\[ *!? *-[a-zA-Z] /) continue

    paired = 0
    for (k2 = 1; k2 <= jn; k2++) {
      other = joined[k2]
      if (other == pline) continue
      if (is_positive_for_subject(other, subj)) { paired = 1; break }
    }
    if (!paired) {
      printf "test-lint: %s: %s — negates %s with no positive assertion on the same subject; absent and merely-unlooked-at both pass (pairing rule)\n", FILENAME, names[i], subj
    }
  }
}

# Each bats test is its own process with its own BATS_TEST_TMPDIR, and
# that boundary is the whole reason order dependence cannot arise in this
# corpus. A shared tmpdir, or a write into the repository, is the only way
# to opt out of it — so both are refused. Reads stay unrestricted: the
# content pins grep the repository constantly, and a read cannot make one
# test depend on another. A line writing into a .bats file is building a
# fixture corpus for another lint run: the forbidden tokens on it are
# data, not behaviour belonging to this test, and are excluded from all
# three checks below exactly as the shell version excluded them.
function check_isolation(i,    k, line, suite_tmp, file_tmp, wrote_root) {
  suite_tmp = 0
  file_tmp = 0
  wrote_root = 0
  for (k = 1; k <= rc[i]; k++) {
    line = rawline[i, k]
    if (line ~ />>* *"[^"]*\.bats"/) continue
    if (index(line, "BATS_SUITE_TMPDIR") > 0) suite_tmp = 1
    if (index(line, "BATS_FILE_TMPDIR") > 0) file_tmp = 1
    if (line ~ /(>>?|cp |mv |rm |mkdir |sed -i|touch )[^|]*\$\{?ROUTINE_REPO_ROOT/) wrote_root = 1
  }
  if (suite_tmp) {
    printf "test-lint: %s: %s — uses BATS_SUITE_TMPDIR; state shared across tests is the only way order can matter (isolation rule)\n", FILENAME, names[i]
  }
  if (file_tmp) {
    printf "test-lint: %s: %s — uses BATS_FILE_TMPDIR; state shared across tests is the only way order can matter (isolation rule)\n", FILENAME, names[i]
  }
  if (wrote_root) {
    printf "test-lint: %s: %s — writes into $ROUTINE_REPO_ROOT; every write belongs in BATS_TEST_TMPDIR (isolation rule)\n", FILENAME, names[i]
  }
}

END {
  # 1. Naming rules, in declaration order: opener, then word count, then
  # length, for each name before moving to the next.
  for (i = 1; i <= n; i++) {
    name = names[i]
    lname = tolower(name)
    if (lname ~ ("^(" openers ") ")) {
      printf "test-lint: %s: %s — opens with a mechanism word; state the claim instead (naming rule)\n", FILENAME, name
    }
    nf = split(name, w, " ")
    if (nf < 3) {
      printf "test-lint: %s: %s — is a label, not a claim (fewer than three words) (naming rule)\n", FILENAME, name
    }
    if (length(name) > 100) {
      printf "test-lint: %s: %s — carries provenance, not a claim (over 100 characters) (naming rule)\n", FILENAME, name
    }
  }

  # 2. Duplicates: uniqueness is scoped to this file, since bats runs and
  # reports one suite at a time, while the same claim in two files is two
  # true statements about two subjects. `sort | uniq -d` used to report
  # each repeated name once, in sorted order; this insertion sort (the
  # corpus of repeats is always tiny) reproduces that ordering in-process.
  for (i = 1; i <= n; i++) cnt[names[i]]++
  dn = 0
  for (i = 1; i <= n; i++) {
    nm = names[i]
    if (cnt[nm] > 1 && !seen[nm]) {
      seen[nm] = 1
      dn++
      duplist[dn] = nm
    }
  }
  for (i = 2; i <= dn; i++) {
    keyv = duplist[i]
    j = i - 1
    while (j >= 1 && duplist[j] > keyv) {
      duplist[j + 1] = duplist[j]
      j--
    }
    duplist[j + 1] = keyv
  }
  for (i = 1; i <= dn; i++) {
    printf "test-lint: %s: %s — is declared twice in this suite; a repeat makes a failure ambiguous (naming rule)\n", FILENAME, duplist[i]
  }

  # 3. Per test, in test order: the body (expectation) rule, then
  # pairing, then isolation — the same order the shell loop produced.
  for (i = 1; i <= n; i++) {
    if (!has_expectation(i)) {
      printf "test-lint: %s: %s — asserts nothing; add an expectation token (body rule)\n", FILENAME, names[i]
    }
    check_pairing(i)
    check_isolation(i)
  }
}
' "$file")"

  if [ -n "$out" ]; then
    while IFS= read -r vline; do
      [ -n "$vline" ] || continue
      printf '%s\n' "$vline"
      violations=$((violations + 1))
    done <<VIOLATIONS
$out
VIOLATIONS
  fi
done

if [ "$violations" -gt 0 ]; then
  echo "test-lint: $violations violation(s) — a name states no claim or a body proves none" >&2
  emit_and_exit 1
fi

echo "test-lint: every test name states its claim and every body proves it"
emit_and_exit 0
