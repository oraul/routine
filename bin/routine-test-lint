#!/usr/bin/env bash
# routine-script: routine-test-lint
# routine-description: A test names the claim it defends and its body proves it — the naming gate and the expectation gate
# routine-usage: routine-test-lint [test-dir] (defaults to the repo's test/)
# routine-exit: 0 — every name states a claim and every body proves it
# routine-exit: 1 — a name or a body violates a rule — the output names file, test and rule family
# routine-exit: 2 — usage — the test directory does not exist
# routine-test: test/test_lint.bats
# A test name is the only part of a suite most readers ever read, so it
# carries the claim. Every threshold below was measured against this
# repository's own corpus before it was written: no name opens with a
# mechanism word, the shortest is three words, the longest 83 characters,
# and no suite repeats a name. A bats test also passes when its last
# command exits 0, so a body that never touches a recognised expectation
# token can never fail and defends no claim either. This lint pins both,
# it does not clean up.
set -u

# shellcheck source=/dev/null
. "$(cd "$(dirname "$0")/.." && pwd)/lib/paths.sh"

root="$(routine_root)"
dir="${1:-$root/test}"

if [ ! -d "$dir" ]; then
  echo "usage: routine-test-lint [test-dir] (defaults to the repo's test/)" >&2
  exit 2
fi

# An opener plus a literal space, never a word boundary: \b is absent from
# BSD grep, and a boundary match refuses `testing/tdd ...`, which is a
# caffeine topic path rather than the word "testing".
openers='test|tests|testing|check|checks|verify|verifies|should|it|ensure|ensures|can|will|does|works|handles|correctly'

# The expectation gate is a token scan, deliberately not a bash parser: a
# scan admits false negatives, and the answer is to widen this list, never
# to start parsing shell. Measured against this repository's own 350
# bodies before it was written: every one matches at least one token.
violations=0
report() {
  echo "test-lint: $1: $2 — $3"
  violations=$((violations + 1))
}

has_expectation() {
  printf '%s\n' "$1" | grep -Fq \
    -e '[ ' -e '[[' -e 'status' -e 'output' -e 'grep' -e 'diff ' \
    -e 'assert' -e 'refute' -e '-eq' -e '-ne' -e '! '
}

# The pairing gate: `! grep -q X "$doc"` passes when $doc does not exist,
# and so does `! grep -rq X "$dir"/*/FILE.md` when the glob matches
# nothing. Neither has proved the forbidden thing absent rather than
# merely unlooked-at, so a negated grep is only trusted when the same
# body also asserts something positive about the same subject.
#
# The subject is the file/glob argument a negated grep line reads: the
# last shell word of the line, up to (but not through) a real unquoted
# pipe. A doubled pipe (||, the OR operator) is not a pipe boundary and
# is skipped so scanning continues past it; a single pipe (real command
# piping) ends the scan, since the file argument for the clause under
# test is whatever came before it. Quoting is tracked so a `|` living
# inside a quoted pattern (an alternation like 'admin|packages') is never
# mistaken for either.
pairing_subject() {
  printf '%s\n' "$1" | awk -v SQ="'" '
  {
    line = $0
    n = length(line)
    sq = 0; dq = 0
    buf = ""
    lastword = ""
    stop = 0
    i = 1
    while (i <= n && !stop) {
      c = substr(line, i, 1)
      if (sq) {
        if (c == SQ) sq = 0
        buf = buf c
        i++
        continue
      }
      if (dq) {
        if (c == "\"") dq = 0
        buf = buf c
        i++
        continue
      }
      if (c == SQ) { sq = 1; buf = buf c; i++; continue }
      if (c == "\"") { dq = 1; buf = buf c; i++; continue }
      if (c == "|") {
        nc = (i < n) ? substr(line, i + 1, 1) : ""
        if (nc == "|") {
          if (buf != "") { lastword = buf; buf = "" }
          i += 2
          continue
        }
        if (buf != "") { lastword = buf; buf = "" }
        stop = 1
        continue
      }
      if (c == " " || c == "\t") {
        if (buf != "") { lastword = buf; buf = "" }
        i++
        continue
      }
      buf = buf c
      i++
    }
    if (buf != "") lastword = buf
    print lastword
  }'
}

# A body line is a candidate negated-grep assertion when a `!` is
# followed by whitespace then the word "grep" — never anchored to line
# start, since the real corpus carries `[ ! -f X ] || ! grep -q Y X` as
# one line, and the bang guarding the grep sits mid-line.
is_negated_grep() {
  printf '%s\n' "$1" | grep -Eq '! +grep($|[^a-zA-Z])'
}

# A candidate protector line: names the same subject, carries some
# expectation token, and is not itself a negation of that same subject
# (another negated grep, or a negated unary test like `! -f`) — two
# negatives about one subject still prove nothing was ever looked at.
is_positive_for_subject() {
  line="$1"; subject="$2"
  printf '%s\n' "$line" | grep -Fq -- "$subject" || return 1

  # A body that BUILDS the subject has established it as surely as one
  # that asserts on it: a fixture write proves the file is there, so the
  # negation that follows cannot be reading an absence.
  printf '%s\n' "$line" | grep -Eq \
    "(>>?|cp |mv |touch |mkdir |tee )[^|]*$(printf '%s' "$subject" \
      | sed 's/[][\.*^$/]/\\&/g')" && return 0

  # An existence test pairs even when negated. `[ ! -f "$f" ] || ! grep -q
  # x "$f"` is the author handling vacuity on purpose — the disjunction
  # says "absent, or present without the forbidden thing", which is the
  # very distinction this rule exists to force.
  printf '%s\n' "$line" | grep -Eq '\[ *!? *-[a-zA-Z] ' && return 0

  printf '%s\n' "$line" | grep -Fq \
    -e '[ ' -e '[[' -e 'grep' -e 'diff ' -e 'assert' -e 'refute' \
    -e '-eq' -e '-ne' || return 1
  is_negated_grep "$line" && return 1
  printf '%s\n' "$line" | grep -Eq '! +-[a-zA-Z]($|[^a-zA-Z])' && return 1
  return 0
}

# $output is exempt by what it is, not by which file or suite asks: bats
# always defines it once `run` has executed, so a negation against it can
# never be vacuous the way a file or glob subject can.
is_exempt_subject() {
  # shellcheck disable=SC2016 # literal source text, deliberately unexpanded
  case "$1" in
    '"$output"' | '$output') return 0 ;;
    *) return 1 ;;
  esac
}

check_pairing() {
  pf="$1"; pname="$2"; pbody="$3"
  while IFS= read -r pline; do
    is_negated_grep "$pline" || continue
    subj="$(pairing_subject "$pline")"
    [ -n "$subj" ] || continue
    is_exempt_subject "$subj" && continue

    # A line can pair itself. `[ ! -f "$f" ] || ! grep -q x "$f"` carries
    # both halves: the disjunction says "absent, or present without the
    # forbidden thing", which is precisely the distinction this rule
    # exists to force. Checked before the scan, which skips this line.
    if printf '%s\n' "$pline" | grep -Eq '\[ *!? *-[a-zA-Z] '; then
      continue
    fi

    paired=1
    while IFS= read -r other; do
      [ "$other" = "$pline" ] && continue
      if is_positive_for_subject "$other" "$subj"; then
        paired=0
        break
      fi
    done <<PBODY
$pbody
PBODY

    if [ "$paired" -eq 1 ]; then
      report "$pf" "$pname" \
        "negates $subj with no positive assertion on the same subject; absent and merely-unlooked-at both pass (pairing rule)"
    fi
  done <<PBODY2
$pbody
PBODY2
}

for file in "$dir"/*.bats; do
  [ -f "$file" ] || continue

  # The name is what bats prints on failure: everything between the first
  # quote and the last one before the opening brace.
  names="$(sed -n 's/^@test  *"\(.*\)" *{.*$/\1/p' "$file")"

  if [ -n "$names" ]; then
    while IFS= read -r name; do
      [ -n "$name" ] || continue

      if printf '%s' "$name" | grep -Eqi "^($openers) "; then
        report "$file" "$name" "opens with a mechanism word; state the claim instead (naming rule)"
      fi

      words="$(printf '%s' "$name" | awk '{print NF}')"
      if [ "$words" -lt 3 ]; then
        report "$file" "$name" "is a label, not a claim (fewer than three words) (naming rule)"
      fi

      if [ "${#name}" -gt 100 ]; then
        report "$file" "$name" "carries provenance, not a claim (over 100 characters) (naming rule)"
      fi
    done <<EOF
$names
EOF

    # Uniqueness is per suite: bats runs and reports one file at a time, so
    # a repeat inside a file makes a failing line ambiguous, while the same
    # claim in two suites is two true statements about two subjects.
    dupes="$(printf '%s\n' "$names" | sort | uniq -d)"
    if [ -n "$dupes" ]; then
      while IFS= read -r dupe; do
        [ -n "$dupe" ] || continue
        report "$file" "$dupe" "is declared twice in this suite; a repeat makes a failure ambiguous (naming rule)"
      done <<EOF
$dupes
EOF
    fi
  fi

  # The expectation gate: extract each test's name and body by counting
  # brace characters (never by parsing shell) so a body spanning several
  # lines, or several tests sharing one line, still yields the right span.
  # A heredoc that happens to hold balanced braces (every fixture in this
  # repo does — JSON, scripts) is scanned along with the rest of the body;
  # a fixture that merely quotes an expectation token is accepted too,
  # which is fine, since building such a corpus is itself assertion-bearing
  # work that this repository always follows with a real check.
  body_name=""
  in_body=0
  body=""
  while IFS= read -r line; do
    case "$line" in
      '@@TL_NAME@@'*)
        body_name="${line#@@TL_NAME@@}"
        body=""
        in_body=1
        ;;
      '@@TL_END@@')
        if [ "$in_body" -eq 1 ] && ! has_expectation "$body"; then
          report "$file" "$body_name" "asserts nothing; add an expectation token (body rule)"
        fi
        if [ "$in_body" -eq 1 ]; then
          check_pairing "$file" "$body_name" "$body"
        fi
        in_body=0
        ;;
      *)
        if [ "$in_body" -eq 1 ]; then
          if [ -z "$body" ]; then
            body="$line"
          else
            body="$body
$line"
          fi
        fi
        ;;
    esac
  done <<EOF
$(awk '
  BEGIN { depth = 0 }
  depth == 0 && /^@test[ \t]/ {
    qstart = index($0, "\"")
    bpos = index($0, "{")
    if (qstart == 0 || bpos == 0) { next }
    upto = substr($0, 1, bpos - 1)
    lastq = 0
    for (k = length(upto); k > qstart; k--) {
      if (substr(upto, k, 1) == "\"") { lastq = k; break }
    }
    if (lastq == 0) { next }
    print "@@TL_NAME@@" substr($0, qstart + 1, lastq - qstart - 1)
    seg = substr($0, bpos)
    depth = 0
    for (k = 1; k <= length(seg); k++) {
      c = substr(seg, k, 1)
      if (c == "{") { depth++ }
      else if (c == "}") { depth-- }
    }
    rest = substr(seg, 2)
    if (length(rest) > 0) { print rest }
    if (depth == 0) { print "@@TL_END@@" }
    next
  }
  depth > 0 {
    for (k = 1; k <= length($0); k++) {
      c = substr($0, k, 1)
      if (c == "{") { depth++ }
      else if (c == "}") { depth-- }
    }
    print
    if (depth == 0) { print "@@TL_END@@" }
  }
' "$file")
EOF
done

if [ "$violations" -gt 0 ]; then
  echo "test-lint: $violations violation(s) — a name states no claim or a body proves none" >&2
  exit 1
fi

echo "test-lint: every test name states its claim and every body proves it"
exit 0
