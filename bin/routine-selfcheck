#!/usr/bin/env bash
# routine-script: routine-selfcheck
# routine-description: Harness integrity gate: caffeine lint, script lint, shellcheck, then the full bats suite
# routine-exit: 0 — all stages green
# routine-exit: 1 — a stage failed — its output is the reason
# routine-test: test/selfcheck.bats
# Harness integrity gate: shellcheck over bin/, lib/, and caffeine
# sidecars, then the full bats suite. Lint failure aborts before tests —
# results from an unparseable script prove nothing.
set -u

. "$(cd "$(dirname "$0")/.." && pwd)/lib/paths.sh"
# shellcheck source=/dev/null
. "$(cd "$(dirname "$0")/.." && pwd)/lib/telemetry.sh"

start_ms="$(routine_now_ms)"

root="$(routine_root)"

# The verdict is computed first, recorded on the way out: emission can
# never change the exit code.
finish() {
  telemetry_harness_emit harness.selfcheck bin/routine-selfcheck "$1" \
    "$(( $(routine_now_ms) - start_ms ))"
  exit "$1"
}

# A malformed topic tree makes downstream results meaningless — the
# caffeine contract is checked before any other stage. Sibling
# resolution: fixture roots need no copy of the lint.
if ! "$(cd "$(dirname "$0")" && pwd)/routine-caffeine-lint"; then
  echo "routine-selfcheck: caffeine topic contract violated" >&2
  finish 1
fi

# A script whose contract lies fails before its tests can pass.
if ! "$(cd "$(dirname "$0")" && pwd)/routine-script-lint"; then
  echo "routine-selfcheck: script contract violated" >&2
  finish 1
fi

scripts=()
for f in "$root"/bin/* "$root"/lib/*.sh "$root"/caffeine/*/*.sh; do
  [ -f "$f" ] || continue
  case "$f" in
    */.gitkeep) continue ;;
  esac
  scripts[${#scripts[@]}]="$f"
done

if [ "${#scripts[@]}" -gt 0 ]; then
  if ! shellcheck "${scripts[@]}"; then
    echo "routine-selfcheck: shellcheck failed" >&2
    finish 1
  fi
fi

if ! bats "$root/test"; then
  echo "routine-selfcheck: bats suite failed" >&2
  finish 1
fi

finish 0
