#!/usr/bin/env bash
# The convention harness: the hard rules and commit grammar as exit codes,
# checked over every commit since a base ref. TARGET = the repo under check
# (default: current directory), so fixtures are ordinary temp repositories.
set -u

target="${TARGET:-$PWD}"
base="${1:-}"
if [ -z "$base" ]; then
  echo "usage: routine-convention-check <base-ref>" >&2
  exit 2
fi

fails=0
fail() {
  echo "convention-check: $1" >&2
  fails=1
}

# Sensitive shapes. Breadth is GitHub secret scanning's job; this list is
# this repository's own hard-rule history. The checker and its tests are
# excluded from the diff scan — they must name what they hunt.
sensitive='claude\.ai/code/session|session_[A-Za-z0-9]{16,}|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{22,}|sk-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}|BEGIN [A-Z ]*PRIVATE KEY'

hits="$(git -C "$target" diff "$base"..HEAD -- . \
  ':(exclude)bin/routine-convention-check' \
  ':(exclude)test/convention_check.bats' \
  | grep -E '^\+' | grep -En "$sensitive" || true)"
if [ -n "$hits" ]; then
  fail "sensitive pattern in the diff:"
  printf '%s\n' "$hits" >&2
fi

for c in $(git -C "$target" rev-list "$base"..HEAD); do
  subject="$(git -C "$target" log -1 --format=%s "$c")"
  body="$(git -C "$target" log -1 --format=%B "$c")"

  if printf '%s\n' "$body" | grep -Eq "$sensitive"; then
    fail "$c: sensitive pattern in the commit message"
  fi

  case "$subject" in
    "Merge pull request #"*) continue ;;
  esac

  if ! printf '%s' "$subject" \
    | grep -Eq '^(spec|feat|fix|test|refactor|docs|ci|chore)(\([a-z_-]+\))?: .+'; then
    fail "$c: subject is not conventional: $subject"
    continue
  fi
  if [ "${#subject}" -gt 72 ]; then
    fail "$c: subject exceeds 72 characters"
  fi
  case "$subject" in
    spec*|feat*|fix*|test*|refactor*)
      printf '%s\n' "$body" | grep -q '^Change: ' \
        || fail "$c: behavior commit missing its 'Change:' trailer"
      ;;
  esac
done

if [ "$fails" -eq 0 ]; then
  echo "convention-check: clean since $base"
fi
exit "$fails"
