#!/usr/bin/env bash
# routine-script: routine-spec-lint
# routine-description: The ticket grammar as exit codes: requirement, briefings, tasks, manifests, grounding
# routine-usage: routine-spec-lint <ticket-dir>
# routine-exit: 0 — grammar satisfied
# routine-exit: 1 — defects found — each names its file and rule
# routine-exit: 2 — usage
# routine-test: test/spec_lint.bats
# Spec grammar lint: structural checks only, pure grep/awk, no semantic
# judgment. Reports every defect in one run so the analyst revises against
# the full list.
set -u

# shellcheck source=/dev/null
. "$(cd "$(dirname "$0")/.." && pwd)/lib/telemetry.sh"

start_ms="$(routine_now_ms)"

ticket="${1:-}"
if [ ! -d "$ticket" ]; then
  echo "usage: routine-spec-lint <ticket-dir>" >&2
  exit 2
fi

fails=0
fail() {
  echo "spec-lint: $1: $2" >&2
  fails=$((fails + 1))
}

# RFC 2119 keywords as whole words, portable to BSD grep (no \b).
rfc2119='(^|[^A-Za-z])(SHALL|MUST|SHOULD|MAY)([^A-Za-z]|$)'

# Grounding: the evidence behind the contract, ticket-level. Structural
# checks only — headers present, Evidence non-empty, and once any task
# carries a defect.md, a Reconciliation line naming that task id, so
# grounding never outlives the evidence that invalidated it.
grounding="$ticket/grounding.md"
if [ ! -f "$grounding" ]; then
  fail "grounding.md" "missing (the evidence behind the contract)"
else
  for _gsec in Evidence Alternatives Assumptions; do
    grep -q "^## $_gsec" "$grounding" \
      || fail "grounding.md" "missing '## $_gsec' section"
  done
  if ! awk '/^## Evidence/ {a=1; next} a && /^#/ {a=0} a && /^- / {found=1} END {exit !found}' "$grounding"; then
    fail "grounding.md" "'## Evidence' has no '- ' bullet"
  fi
  for _dfile in "$ticket"/briefings/*/tasks/*/defect.md; do
    [ -f "$_dfile" ] || continue
    _db="$(basename "$(dirname "$(dirname "$(dirname "$_dfile")")")")"
    _dt="$(basename "$(dirname "$_dfile")")"
    _dtid="${_db%%-*}-${_dt%%-*}"
    if ! awk '/^## Reconciliation/ {a=1; next} a && /^#/ {a=0} a {print}' "$grounding" \
      | grep -q "$_dtid"; then
      fail "grounding.md" "defect on $_dtid needs a '## Reconciliation' line naming it"
    fi
  done
fi

req="$ticket/requirement.md"
work_type=""
if [ ! -f "$req" ]; then
  fail "requirement.md" "missing"
else
  grep -q '^# Requirement:' "$req" \
    || fail "requirement.md" "no '# Requirement:' header"
  grep -Eq "$rfc2119" "$req" \
    || fail "requirement.md" "no RFC 2119 keyword"
  work_type="$(awk '/^Type: / {print $2; exit}' "$req")"
  case "$work_type" in
    bug|feature|greenfield|epic) ;;
    *) fail "requirement.md" "Type must be one of: bug, feature, greenfield, epic" ;;
  esac
  # Typed contract topics (contract capability): each work type hands the
  # developer its own section, checked here — before approve, not after.
  case "$work_type" in
    bug)
      grep -q '^## Reproduction' "$req" \
        || fail "requirement.md" "a bug requires a '## Reproduction' section" ;;
    feature)
      grep -q '^## Touchpoints' "$req" \
        || fail "requirement.md" "a feature requires a '## Touchpoints' section naming the code it extends" ;;
    greenfield)
      grep -q '^## Contracts' "$req" \
        || fail "requirement.md" "a greenfield requires a '## Contracts' section (inputs/outputs/invariants)" ;;
    epic)
      grep -q '^## Order' "$req" \
        || fail "requirement.md" "an epic requires an '## Order' section stating the order of value" ;;
  esac
fi

caffeine_root="$(cd "$(dirname "$0")/.." && pwd)/caffeine"

found_briefing=0
for bdir in "$ticket"/briefings/*/; do
  [ -d "$bdir" ] || continue
  found_briefing=1
  b="briefings/$(basename "$bdir")"
  if [ ! -f "${bdir}briefing.md" ]; then
    fail "$b/briefing.md" "missing"
  fi
  found_task=0
  for tdir in "${bdir}tasks/"*/; do
    [ -d "$tdir" ] || continue
    found_task=1
    t="$b/tasks/$(basename "$tdir")"
    tm="${tdir}task.md"
    if [ ! -f "$tm" ]; then
      fail "$t/task.md" "missing"
      continue
    fi
    if ! grep -Eq '(^|[-*[:space:]])Given' "$tm" \
      || ! grep -Eq '(^|[-*[:space:]])When' "$tm" \
      || ! grep -Eq '(^|[-*[:space:]])Then' "$tm"; then
      fail "$t/task.md" "no Given/When/Then scenario"
    fi
    # Scenario labels are the join key the audit binds evidence to.
    if ! grep -Eq '^## Scenario: .+' "$tm"; then
      fail "$t/task.md" "no '## Scenario: <label>' heading (the audit binds tdd evidence to labels)"
    fi
    if ! grep -q '^## Caffeine' "$tm"; then
      fail "$t/task.md" "no '## Caffeine' section"
    else
      # Manifest validity at the handoff: exact '- <topic>' form, and every
      # topic resolves — an unbuildable manifest fails the analyst's side.
      manifest_lines="$(awk '/^## Caffeine/ {a=1; next} a && /^#/ {a=0} a && NF {print}' "$tm")"
      manifest_topics=0
      while IFS= read -r mline; do
        [ -n "$mline" ] || continue
        case "$mline" in
          "- "*)
            manifest_topics=$((manifest_topics + 1))
            topic="${mline#- }"
            if [ ! -f "$caffeine_root/$topic.sh" ] && [ ! -f "$caffeine_root/$topic.md" ]; then
              # Refusals teach: name the vocabulary, not just the miss.
              available="$(find "$caffeine_root" -mindepth 2 -maxdepth 2 -name '*.md' 2>/dev/null \
                | sed "s|^$caffeine_root/||; s|\.md$||" | sort | tr '\n' ' ')"
              fail "$t/task.md" "manifest topic '$topic' resolves to no caffeine/$topic.{sh,md}; available topics: ${available:-none}"
            fi
            ;;
          *)
            fail "$t/task.md" "manifest line '$mline' must use the exact form '- <topic>'"
            ;;
        esac
      done <<EOF_MANIFEST
$manifest_lines
EOF_MANIFEST
      # An empty manifest is unconsidered, not inapplicable: testing/tdd
      # applies to any task that goes red -> green, which is every task.
      if [ "$manifest_topics" -eq 0 ]; then
        fail "$t/task.md" "empty caffeine manifest — every task names at least one topic (testing/tdd applies to any task)"
      fi
    fi
    if ! grep -q '^## Acceptance' "$tm"; then
      fail "$t/task.md" "no '## Acceptance' section"
    elif ! awk '/^## Acceptance/ {a=1; next}
                a && /^#/ {a=0}
                a && /^([0-9]+\.|- )/ {found=1}
                END {exit !found}' "$tm"; then
      fail "$t/task.md" "empty acceptance list"
    fi
  done
  [ "$found_task" -eq 1 ] || fail "$b" "briefing has no tasks"
done
[ "$found_briefing" -eq 1 ] || fail "briefings" "no briefings"

if [ "$work_type" = "epic" ]; then
  briefing_count=0
  for bdir in "$ticket"/briefings/*/; do
    [ -d "$bdir" ] && briefing_count=$((briefing_count + 1))
  done
  [ "$briefing_count" -ge 2 ] \
    || fail "briefings" "an epic decomposes into at least two briefings"
fi

code=0
[ "$fails" -eq 0 ] || code=1
telemetry_emit "$ticket/telemetry.jsonl" spec.lint bin/routine-spec-lint \
  "$(basename "$ticket")" "" "$code" "$(( $(routine_now_ms) - start_ms ))"
[ "$code" -eq 0 ] && echo "spec-lint: ok"
exit "$code"
