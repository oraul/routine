#!/usr/bin/env bash
# Releases a block: returns a blocked task to pending, refusing unless
# unblock.md carries the human's unblocking context. A task-id addresses
# exactly that task; without one the first blocked task is released.
set -u

lib="$(cd "$(dirname "$0")/.." && pwd)/lib"
# shellcheck source=/dev/null
. "$lib/telemetry.sh"
# shellcheck source=/dev/null
. "$lib/index.sh"

start_ms="$(routine_now_ms)"

TAB="$(printf '\t')"

ticket="${1:-}"
task_id="${2:-}"
if [ ! -d "$ticket" ] || [ ! -f "$ticket/index.tsv" ]; then
  echo "usage: routine-unblock <ticket-dir> [task-id]" >&2
  exit 2
fi

# Refusals are transitions that didn't happen — they still leave one line.
refuse() {
  echo "routine-unblock: $2" >&2
  telemetry_emit "$ticket/telemetry.jsonl" ticket.unblock bin/routine-unblock \
    "$(basename "$ticket")" "$1" 1 "$(( $(routine_now_ms) - start_ms ))"
  exit 1
}

if [ -n "$task_id" ]; then
  if ! row="$(grep "^$task_id$TAB" "$ticket/index.tsv" | head -n 1)" \
    || [ -z "$row" ]; then
    refuse "" "no task $task_id in the index"
  fi
  _status="$(printf '%s' "$row" | cut -f4)"
  if [ "$_status" != blocked ]; then
    refuse "$task_id" "task $task_id is $_status, not blocked"
  fi
elif ! row="$(index_first_with_status "$ticket/index.tsv" blocked)"; then
  refuse "" "no task is blocked"
fi
tid="$(printf '%s' "$row" | cut -f1)"
b="$(printf '%s' "$row" | cut -f2)"
t="$(printf '%s' "$row" | cut -f3)"

if [ ! -f "$ticket/briefings/$b/tasks/$t/unblock.md" ]; then
  refuse "$tid" "refuse — write briefings/$b/tasks/$t/unblock.md first"
fi

ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
index_set_status "$ticket/index.tsv" "$tid" pending "$ts"
telemetry_emit "$ticket/telemetry.jsonl" ticket.unblock bin/routine-unblock \
  "$(basename "$ticket")" "$tid" 0 "$(( $(routine_now_ms) - start_ms ))"
echo "routine-unblock: $tid released to pending"
exit 0
