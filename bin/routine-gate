#!/usr/bin/env bash
# routine-script: routine-gate
# routine-description: Run one named gate's checks and record the verdict as telemetry
# routine-usage: routine-gate <preflight|analyst|developer>
# routine-env: ROUTINE_TICKET_DIR — the active ticket; preflight fails closed without it
# routine-env: TARGET — the target project the developer gate's hook runs in
# routine-exit: 0 — gate passed
# routine-exit: 1 — gate failed — the output is the reason
# routine-exit: 2 — usage — the gate name must be one of the three
# routine-test: test/gate.bats
# Gate runner: composes selfcheck (preflight only) -> gate baseline -> app
# hook into one exit-code decision. Exit 0 passes; the first non-zero stage
# aborts the run and its output is the reason.
set -u

repo_dir="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=/dev/null
. "$repo_dir/lib/paths.sh"
# shellcheck source=/dev/null
. "$repo_dir/lib/telemetry.sh"
# shellcheck source=/dev/null
. "$repo_dir/lib/index.sh"
# shellcheck source=/dev/null
. "$repo_dir/lib/episode.sh"

gate="${1:-}"
case "$gate" in
  preflight|analyst|developer) ;;
  *)
    echo "routine-gate: unknown gate '${gate}'" >&2
    echo "usage: routine-gate <preflight|analyst|developer>" >&2
    exit 2
    ;;
esac

root="$(routine_root)"
target="${TARGET:-$PWD}"

app_key() {
  _top="$(git -C "$target" rev-parse --show-toplevel 2>/dev/null)" || _top="$target"
  basename "$_top"
}

# Seam contract: optional hooks log one line and pass when missing; the
# developer hook is mandatory because it is the app's lint+test facade.
# Either outcome is evidence: gate.hook when it ran, gate.hook.absent when
# an optional hook was missing — a pass-by-run and a pass-by-absence must
# never be byte-identical in telemetry.
run_hook() {
  _app="$(app_key)"
  _hook="$root/runs/$_app/hooks/$1.sh"
  if [ -f "$_hook" ]; then
    _h0="$(routine_now_ms)"
    TARGET="$target" bash "$_hook"
    _hcode="$?"
    telemetry_gate_emit gate.hook "runs/$_app/hooks/$1.sh" "$_hcode" \
      "$(( $(routine_now_ms) - _h0 ))"
    return "$_hcode"
  elif [ "$1" = developer ]; then
    echo "routine-gate: missing mandatory hook: runs/$_app/hooks/developer.sh" >&2
    echo "routine-gate: create it with one line delegating to the app's own tooling, e.g.: cd \"\$TARGET\" && bin/ci" >&2
    return 1
  else
    echo "routine-gate: no $1 hook for $_app; passing"
    telemetry_gate_emit gate.hook.absent "runs/$_app/hooks/$1.sh" 0 0
    return 0
  fi
}

TAB="$(printf '\t')"

# Analyst baseline: the ticket must pass the spec grammar and its index must
# agree with the directory tree. The ticket arrives via ROUTINE_TICKET_DIR —
# the same channel telemetry uses.
baseline_analyst() {
  if [ -z "${ROUTINE_TICKET_DIR:-}" ]; then
    echo "routine-gate: analyst gate requires a ticket context (set ROUTINE_TICKET_DIR)" >&2
    return 1
  fi
  # The revise limit is counted, never remembered, and the count lives in
  # lib/episode.sh — one implementation for the gate that spends the
  # budget and every reader that reports it.
  _revises="$(episode_revise_count "$ROUTINE_TICKET_DIR/telemetry.jsonl")"
  if [ "$_revises" -gt 3 ]; then
    echo "routine-gate: revise limit exhausted ($_revises failed lint runs this episode); run routine-abort with the reason" >&2
    return 1
  fi
  "$root/bin/routine-spec-lint" "$ROUTINE_TICKET_DIR" || return 1
  _index="$ROUTINE_TICKET_DIR/index.tsv"
  if [ ! -f "$_index" ]; then
    echo "routine-gate: ticket has no index.tsv" >&2
    return 1
  fi
  # Fresh tickets are coherent by construction: derive missing rows the
  # same append-only way routine-next would, before judging coherence.
  index_sync "$ROUTINE_TICKET_DIR" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  _bad=0
  while IFS="$TAB" read -r _tid _b _t _rest; do
    [ -n "$_tid" ] || continue
    if [ ! -d "$ROUTINE_TICKET_DIR/briefings/$_b/tasks/$_t" ]; then
      echo "routine-gate: index row $_tid has no directory briefings/$_b/tasks/$_t" >&2
      _bad=1
    fi
  done < "$_index"
  for _bdir in "$ROUTINE_TICKET_DIR"/briefings/*/; do
    [ -d "$_bdir" ] || continue
    _b="$(basename "$_bdir")"
    for _tdir in "${_bdir}tasks/"*/; do
      [ -d "$_tdir" ] || continue
      _t="$(basename "$_tdir")"
      if ! grep -q "^${_b%%-*}-${_t%%-*}$TAB" "$_index"; then
        echo "routine-gate: task directory briefings/$_b/tasks/$_t has no index row" >&2
        _bad=1
      fi
    done
  done
  return "$_bad"
}

# Developer baseline: run every sidecar the current task's caffeine
# manifest names, one gate.developer.script telemetry line per run. The
# current task derives from the in-progress index row — never chosen.
baseline_developer() {
  if [ -z "${ROUTINE_TICKET_DIR:-}" ]; then
    echo "routine-gate: developer gate requires a ticket context (set ROUTINE_TICKET_DIR)" >&2
    return 1
  fi
  if ! _row="$(index_first_with_status "$ROUTINE_TICKET_DIR/index.tsv" in_progress)"; then
    echo "routine-gate: no task is in_progress; run routine-next before the developer gate" >&2
    return 1
  fi
  _b="$(printf '%s' "$_row" | cut -f2)"
  _t="$(printf '%s' "$_row" | cut -f3)"
  _taskfile="$ROUTINE_TICKET_DIR/briefings/$_b/tasks/$_t/task.md"
  [ -f "$_taskfile" ] || { echo "routine-gate: missing $_taskfile" >&2; return 1; }
  _topics="$(awk '/^## Caffeine/ {a=1; next} a && /^#/ {a=0} a && /^- / {print substr($0, 3)}' "$_taskfile")"
  [ -n "$_topics" ] || return 0
  for _topic in $_topics; do
    _sidecar="$root/caffeine/$_topic.sh"
    if [ ! -f "$_sidecar" ]; then
      if [ -f "$root/caffeine/$_topic.md" ]; then
        echo "routine-gate: $_topic is doc-only; guidance loads, nothing to run"
        telemetry_gate_emit gate.developer.doc "caffeine/$_topic.md" 0 0
        continue
      fi
      echo "routine-gate: manifest names $_topic but neither caffeine/$_topic.sh nor caffeine/$_topic.md exists" >&2
      return 1
    fi
    _s0="$(routine_now_ms)"
    TARGET="$target" bash "$_sidecar"
    _code="$?"
    telemetry_gate_emit gate.developer.script "caffeine/$_topic.sh" "$_code" \
      "$(( $(routine_now_ms) - _s0 ))"
    if [ "$_code" -ne 0 ]; then
      echo "routine-gate: sidecar caffeine/$_topic.sh failed" >&2
      return "$_code"
    fi
  done
  return 0
}

# Preflight baseline: the target must be a git worktree that is clean
# (nothing staged, modified, or untracked) and checked out on a branch.
# The audit demands preflight evidence, so an unrecordable preflight is
# a protocol error now, not a mystery at conclude.
baseline_preflight() {
  if [ -z "${ROUTINE_TICKET_DIR:-}" ]; then
    echo "routine-gate: preflight requires a ticket context (set ROUTINE_TICKET_DIR)" >&2
    return 1
  fi
  if ! git -C "$target" rev-parse --git-dir >/dev/null 2>&1; then
    echo "routine-gate: target is not a git repository: $target" >&2
    return 1
  fi
  if [ -n "$(git -C "$target" status --porcelain)" ]; then
    echo "routine-gate: target worktree is not clean: $target" >&2
    git -C "$target" status --short >&2
    return 1
  fi
  if ! git -C "$target" symbolic-ref -q HEAD >/dev/null; then
    echo "routine-gate: target HEAD is detached; check out a branch" >&2
    return 1
  fi
  return 0
}

run_gate() {
  case "$gate" in
    preflight)
      "$root/bin/routine-selfcheck" || return "$?"
      baseline_preflight || return "$?"
      run_hook preflight || return "$?"
      ;;
    analyst)
      baseline_analyst || return "$?"
      run_hook analyst || return "$?"
      ;;
    developer)
      baseline_developer || return "$?"
      run_hook developer || return "$?"
      ;;
  esac
}

# The gate's reasons must outlive the session that ran them: recovering
# them by re-running costs a counted revise (analyst) or a full
# lint-and-test cycle (developer). gate.log is a script-owned mirror —
# stdout and stderr still reach the caller live and unchanged. Truncated
# per run, and only once a ticket context exists, so a usage error never
# touches a ticket.
start_ms="$(routine_now_ms)"
if [ -n "${ROUTINE_TICKET_DIR:-}" ] && [ -d "${ROUTINE_TICKET_DIR:-}" ]; then
  _glog="$ROUTINE_TICKET_DIR/gate.log"
  : > "$_glog"
  # Process substitution, not a pipeline: the gate's exit code is the
  # gate's own, and both streams still reach the caller as they always did.
  exec > >(tee -a "$_glog") 2> >(tee -a "$_glog" >&2)
fi
run_gate
code="$?"
telemetry_gate_emit "gate.$gate" "bin/routine-gate" "$code" "$(( $(routine_now_ms) - start_ms ))"
exit "$code"
