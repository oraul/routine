#!/usr/bin/env bash
# routine-script: routine-conclude
# routine-description: Archive a finished ticket with its report; refuses unfinished tasks or a failing audit
# routine-usage: routine-conclude <ticket-dir>
# routine-exit: 0 — concluded — report written, ticket archived, path printed
# routine-exit: 1 — refused — unfinished tasks or audit violations, each named
# routine-exit: 2 — usage
# routine-test: test/conclude.bats
# The scripted ticket ending: refuses while work remains, writes report.md
# from the index, emits ticket.conclude, and archives the ticket directory.
set -u

lib="$(cd "$(dirname "$0")/.." && pwd)/lib"
# shellcheck source=/dev/null
. "$lib/telemetry.sh"

start_ms="$(routine_now_ms)"

TAB="$(printf '\t')"

ticket="${1:-}"
if [ ! -d "$ticket" ] || [ ! -f "$ticket/index.tsv" ]; then
  echo "usage: routine-conclude <ticket-dir>" >&2
  exit 2
fi

unfinished="$(awk -F'\t' '$4!="done" {print $1}' "$ticket/index.tsv")"
if [ -n "$unfinished" ]; then
  echo "routine-conclude: refuse — tasks not done:" >&2
  printf '%s\n' "$unfinished" >&2
  telemetry_emit "$ticket/telemetry.jsonl" ticket.conclude bin/routine-conclude \
    "$(basename "$ticket")" "" 1 "$(( $(routine_now_ms) - start_ms ))"
  exit 1
fi

# Done rows are a claim; the audit checks the evidence backs it.
if ! audit_out="$("$(cd "$(dirname "$0")" && pwd)/routine-audit" "$ticket" 2>&1)"; then
  echo "routine-conclude: refuse — the run audit failed:" >&2
  printf '%s\n' "$audit_out" >&2
  telemetry_emit "$ticket/telemetry.jsonl" ticket.conclude bin/routine-conclude \
    "$(basename "$ticket")" "" 1 "$(( $(routine_now_ms) - start_ms ))"
  exit 1
fi

id="$(basename "$ticket")"
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

{
  echo "# Report: ticket $id"
  echo
  echo "Concluded: $ts"
  echo
  echo "| task | briefing | dir | status | updated |"
  echo "|------|----------|-----|--------|---------|"
  while IFS="$TAB" read -r r_id r_b r_t r_status r_ts; do
    [ -n "$r_id" ] || continue
    echo "| $r_id | $r_b | $r_t | $r_status | $r_ts |"
  done < "$ticket/index.tsv"
} > "$ticket/report.md"

telemetry_emit "$ticket/telemetry.jsonl" ticket.conclude bin/routine-conclude \
  "$id" "" 0 "$(( $(routine_now_ms) - start_ms ))"

archive="$(dirname "$ticket")/archive"
mkdir -p "$archive"
mv "$ticket" "$archive/$id"
echo "routine-conclude: ticket $id archived at $archive/$id"
exit 0
