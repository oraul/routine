#!/usr/bin/env bash
# routine-script: routine-ticket-new
# routine-description: Allocate the next ticket directory with script-owned state files
# routine-env: TARGET — the target project whose runs/ holds the tickets
# routine-exit: 0 — ticket created — path printed
# routine-exit: 1 — refused — the app is not scaffolded yet
# routine-test: test/ticket_new.bats
# Ticket allocation: next sequential 4-digit id under runs/<app>/tickets/,
# scanning active and archived tickets so concluded ids are never reused.
set -u

lib="$(cd "$(dirname "$0")/.." && pwd)/lib"
# shellcheck source=/dev/null
. "$lib/paths.sh"
# shellcheck source=/dev/null
. "$lib/telemetry.sh"

start_ms="$(routine_now_ms)"

root="$(routine_root)"
target="${TARGET:-$PWD}"
app="$(routine_app_key "$target")"
tickets="$root/runs/$app/tickets"

if [ ! -d "$tickets" ]; then
  echo "routine-ticket-new: no state for $app; run routine-scaffold first" >&2
  exit 1
fi

max=0
for d in "$tickets"/[0-9][0-9][0-9][0-9] "$tickets"/archive/[0-9][0-9][0-9][0-9]; do
  [ -d "$d" ] || continue
  n=$((10#$(basename "$d")))
  if [ "$n" -gt "$max" ]; then max="$n"; fi
done

id="$(printf '%04d' $((max + 1)))"
mkdir "$tickets/$id"
: > "$tickets/$id/index.tsv"
telemetry_emit "$tickets/$id/telemetry.jsonl" ticket.new bin/routine-ticket-new \
  "$id" "" 0 "$(( $(routine_now_ms) - start_ms ))"
echo "$tickets/$id"
exit 0
