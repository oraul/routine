#!/usr/bin/env bash
# routine-script: routine-defect
# routine-description: The developer's defective-spec return: record the reason, rewind the task to pending
# routine-usage: routine-defect <ticket-dir> <reason>
# routine-exit: 0 — recorded — defect.md appended, task returned to the line
# routine-exit: 1 — refused — no task is in_progress, or the task's defect budget is exhausted
# routine-exit: 2 — usage — a directory and a stated defect are both required
# routine-test: test/defect.bats
# The developer's defective-spec return: evidence first, then the task goes
# back to pending and the run rewinds to specify. Mirrors the blockage
# pattern — a sequencing decision is never carried by prose (Law 1).
set -u

lib="$(cd "$(dirname "$0")/.." && pwd)/lib"
# shellcheck source=/dev/null
. "$lib/telemetry.sh"
# shellcheck source=/dev/null
. "$lib/index.sh"
# shellcheck source=/dev/null
. "$lib/episode.sh"

start_ms="$(routine_now_ms)"

ticket="${1:-}"
reason="${2:-}"
if [ ! -d "$ticket" ] || [ ! -f "$ticket/index.tsv" ]; then
  echo "usage: routine-defect <ticket-dir> <reason>" >&2
  exit 2
fi
if [ -z "$reason" ]; then
  echo "routine-defect: refuse — state the defect (a reason is the evidence)" >&2
  exit 2
fi

if ! row="$(index_first_with_status "$ticket/index.tsv" in_progress)"; then
  echo "routine-defect: no task is in_progress" >&2
  exit 1
fi
tid="$(printf '%s' "$row" | cut -f1)"
b="$(printf '%s' "$row" | cut -f2)"
t="$(printf '%s' "$row" | cut -f3)"

# The return budget is counted, never remembered, and the count lives in
# lib/episode.sh — one implementation for this script and every reader
# that reports it. Bounded per task, not per ticket (design.md): a
# ticket whose tasks each returned once is healthy, a task returned
# three times is not.
defects="$(episode_defect_count "$ticket/telemetry.jsonl" "$tid")"
if [ "$defects" -ge 3 ]; then
  echo "routine-defect: return limit exhausted ($defects defect returns for $tid); run routine-abort with the reason" >&2
  exit 1
fi

# Append, never truncate: repeated returns keep the full history the
# re-specifying analyst needs, newest last under its own timestamp.
{
  printf '## %s\n\n%s\n\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$reason"
} >> "$ticket/briefings/$b/tasks/$t/defect.md"
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
index_set_status "$ticket/index.tsv" "$tid" pending "$ts"
telemetry_emit "$ticket/telemetry.jsonl" spec.defective bin/routine-defect \
  "$(basename "$ticket")" "$tid" 1 "$(( $(routine_now_ms) - start_ms ))"
echo "routine-defect: $tid returned to specify — $reason"
exit 0
