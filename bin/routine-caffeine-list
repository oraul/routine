#!/usr/bin/env bash
# routine-script: routine-caffeine-list
# routine-description: Print the caffeine vocabulary computed from the corpus — never curated
# routine-exit: 0 — catalog printed, one topic per line
# routine-test: test/caffeine_list.bats
# The topic catalog, computed never stored: walks caffeine/ and prints
# one line per topic — topic, mode (pair|doc-only), and the doc's first
# prose line — so the analyst authors manifests from a menu, not a guess.
set -u

# shellcheck source=/dev/null
. "$(cd "$(dirname "$0")/.." && pwd)/lib/paths.sh"

root="$(routine_root)"

[ -d "$root/caffeine" ] || exit 0

for _md in "$root"/caffeine/*/*.md; do
  [ -f "$_md" ] || continue
  _ns="$(basename "$(dirname "$_md")")"
  _t="$(basename "$_md" .md)"
  _mode="doc-only"
  [ -f "$root/caffeine/$_ns/$_t.sh" ] && _mode="pair"
  # The lede: first line that is neither the H1, a metadata comment, nor
  # blank.
  _lede="$(awk '/^# / || /^<!--/ || /^[[:space:]]*$/ {next} {print; exit}' "$_md")"
  printf '%-28s %-9s %s\n' "$_ns/$_t" "$_mode" "$_lede"
done | sort
exit 0
