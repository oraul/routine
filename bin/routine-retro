#!/usr/bin/env bash
# routine-script: routine-retro
# routine-description: Aggregate archived tickets' telemetry into the retro report; pure reader
# routine-exit: 0 — report printed
# routine-test: test/retro.bats
# The feedback loop: aggregate every ticket's telemetry into a plain-text
# report. Computes, never stores. Pure awk over the fixed-key-order lines;
# timestamp math via the civil-days algorithm (BSD awk has no mktime).
set -u

# shellcheck source=/dev/null
. "$(cd "$(dirname "$0")/.." && pwd)/lib/paths.sh"

root="$(routine_root)"

files=()
for f in "$root"/runs/*/tickets/*/telemetry.jsonl \
         "$root"/runs/*/tickets/archive/*/telemetry.jsonl; do
  [ -f "$f" ] || continue
  files[${#files[@]}]="$f"
done

if [ "${#files[@]}" -eq 0 ]; then
  echo "routine-retro: no telemetry found under $root/runs"
  exit 0
fi

# awk reads the files itself (no cat) so FILENAME carries the app
# dimension: blocked pairing must never cross apps, where ticket ids
# can collide.
awk -F'"' '
  function epoch(t,    y, m, d, H, M, S, era, yoe, doy, doe) {
    y = substr(t, 1, 4) + 0; m = substr(t, 6, 2) + 0; d = substr(t, 9, 2) + 0
    H = substr(t, 12, 2) + 0; M = substr(t, 15, 2) + 0; S = substr(t, 18, 2) + 0
    if (m <= 2) { y -= 1; m += 12 }
    era = int(y / 400); yoe = y - era * 400
    doy = int((153 * (m - 3) + 2) / 5) + d - 1
    doe = yoe * 365 + int(yoe / 4) - int(yoe / 100) + doy
    return (era * 146097 + doe - 719468) * 86400 + H * 3600 + M * 60 + S
  }
  function isort(arr, n,    i, j, tmp) {
    for (i = 2; i <= n; i++) {
      tmp = arr[i]; j = i - 1
      while (j > 0 && arr[j] > tmp) { arr[j + 1] = arr[j]; j-- }
      arr[j + 1] = tmp
    }
  }
  function rank(n, p,    r) { r = int(n * p); if (r * 1.0 < n * p) r++; if (r < 1) r = 1; return r }
  {
    m = split(FILENAME, fp, "/")
    app = ""
    for (i = 1; i < m; i++) if (fp[i] == "runs") { app = fp[i + 1]; break }
    ts = $4; event = $8; script = $12; ticket = $16; task = $20
    ex = $23; gsub(/[^0-9-]/, "", ex)
    ms = $25; gsub(/[^0-9-]/, "", ms)
    runs[event]++
    sruns[script]++
    # A failure is classified per event, never by a blanket non-zero
    # test. routine-tdd red REQUIRES a failing command, so a non-zero
    # red is the protocol working and a zero one is the anomaly;
    # routine-next exits 3 and 4 report a blocked line and an
    # exhausted one, both normal outcomes.
    failed = 0
    if (event == "tdd.red") {
      if (ex + 0 == 0) redpass[script] = 1
    } else if (event == "ticket.next") {
      if (ex + 0 == 1 || ex + 0 == 2) failed = 1
    } else if (ex + 0 != 0) {
      failed = 1
    }
    if (failed) {
      fails[event]++
      # Only path-shaped script fields name scripts; tdd records carry a
      # scenario label there, which belongs in no script list.
      if (script ~ /^(bin|lib|caffeine)\//) sfails[script]++
    }
    durs[event] = durs[event] " " ms
    bkey = app "\t" ticket "\t" task
    # A refused transition is not a transition: a non-zero block would
    # otherwise start a timer nothing ever closes.
    if (event == "ticket.block" && ex + 0 == 0) bstart[bkey] = epoch(ts)
    if (event == "ticket.unblock" && ex + 0 == 0 && bkey in bstart) {
      blocked[bkey] += epoch(ts) - bstart[bkey]
      delete bstart[bkey]
    }
    # Re-specify cost, gate-identical semantics: the per-episode failed
    # lint counter resets on spec.defective; recovery is defect to the
    # next passing lint. App-scoped key — ticket ids collide across apps.
    rkey = app "\t" ticket
    if (event == "spec.defective") {
      repi[rkey]++; rcur[rkey] = 0; rstart[rkey] = epoch(ts)
    }
    if (event == "spec.lint") {
      if (ex + 0 != 0) {
        rcur[rkey]++; rfail[rkey]++
        if (rcur[rkey] > rworst[rkey]) rworst[rkey] = rcur[rkey]
      } else if (rkey in rstart) {
        rrec[rkey] += epoch(ts) - rstart[rkey]
        delete rstart[rkey]
      }
    }
  }
  # Sections print through sort so the report is deterministic — output
  # is evidence, never hash order. The caffeine section ranks by failure
  # count descending: the printed order IS the deepening queue.
  END {
    print "routine retro"
    print ""
    print "events:"
    fflush()
    for (e in runs) {
      n = split(substr(durs[e], 2), a, " ")
      isort(a, n)
      printf("  %-22s runs=%-3d fails=%-3d ms min=%s p50=%s p95=%s max=%s\n", \
        e, runs[e], fails[e] + 0, a[1], a[rank(n, 0.5)], a[rank(n, 0.95)], a[n]) | "sort"
    }
    close("sort")
    print ""
    print "script failures:"
    fflush()
    for (s in sfails) printf("  %-26s %d\n", s, sfails[s]) | "sort"
    close("sort")
    print ""
    print "caffeine topics:"
    fflush()
    for (s in sruns) {
      if (s !~ /^caffeine\//) continue
      f = sfails[s] + 0
      # Ranked by accumulated failures, not by rate: one unlucky run at
      # 1.00 must never outrank many runs that failed many times. The
      # rate and the run count ride along for context.
      printf("  %6d  %.2f  %-36s runs=%d\n", f, f / sruns[s], s, sruns[s]) | "sort -rn"
    }
    close("sort -rn")
    print ""
    print "reds that passed:"
    fflush()
    anyrp = 0
    for (s in redpass) { anyrp = 1; printf("  %s\n", s) | "sort" }
    close("sort")
    if (!anyrp) print "  none"
    print ""
    print "re-specify cost:"
    fflush()
    for (k in rfail) seen_cost[k] = 1
    for (k in repi) seen_cost[k] = 1
    for (k in seen_cost) {
      split(k, p, "\t")
      tail = (k in rstart) ? "unrecovered" : "recovery_s=" rrec[k] + 0
      printf("  %s %s  episodes=%d failed_lints=%d worst_episode=%d %s\n", \
        p[1], p[2], repi[k] + 1, rfail[k] + 0, rworst[k] + 0, tail) | "sort"
    }
    close("sort")
    print ""
    print "blocked seconds:"
    fflush()
    for (k in blocked) { split(k, p, "\t"); printf("  %s %s %s  %d\n", p[1], p[2], p[3], blocked[k]) | "sort" }
    for (k in bstart) { split(k, p, "\t"); printf("  %s %s %s  still blocked\n", p[1], p[2], p[3]) | "sort" }
    close("sort")
  }
' "${files[@]}"
exit 0
