#!/usr/bin/env bash
# routine-script: routine-approve
# routine-description: Record the human checkpoint: the proceed and any remarks become ticket evidence
# routine-usage: routine-approve <ticket-dir> [note]
# routine-exit: 0 — recorded — ticket.approve on the record, note appended when given
# routine-exit: 1 — refused — no passing gate.analyst on record, or grounding.md carries a non-floor '## Questions' section and no note was given
# routine-exit: 2 — usage — a ticket directory with telemetry is required
# routine-test: test/approve.bats
# The human checkpoint as evidence: records the proceed (and any remarks)
# the approve phase used to lose to the transcript. Refuses to approve
# artifacts the analyst gate never passed — approval orders after the
# gate by construction, never by claim.
set -u

lib="$(cd "$(dirname "$0")/.." && pwd)/lib"
# shellcheck source=/dev/null
. "$lib/telemetry.sh"

start_ms="$(routine_now_ms)"

ticket="${1:-}"
note="${2:-}"
if [ ! -d "$ticket" ] || [ ! -f "$ticket/telemetry.jsonl" ]; then
  echo "usage: routine-approve <ticket-dir> [note]" >&2
  exit 2
fi

if ! grep -q '"event":"gate.analyst"[^}]*"exit":0,' "$ticket/telemetry.jsonl"; then
  echo "routine-approve: no passing gate.analyst on record — approval of ungated artifacts is meaningless" >&2
  exit 1
fi

# A question only the operator can answer is cheap to overturn now and a
# caller-visible break after implementation. The '- none — <why>' floor
# (same shape routine-record-lint already applies) means asking is a
# deliberate act, so only a deliberately-raised, still-unanswered question
# blocks — and a note counts as the human having answered it.
grounding="$ticket/grounding.md"
if [ -z "$note" ] && [ -f "$grounding" ] && grep -q '^## Questions' "$grounding"; then
  non_floor="$(awk '
    /^## Questions/ {a=1; next}
    a && /^#/ {a=0}
    a && /^- / {
      label = $0
      sub(/^- /, "", label)
      if (label !~ /^none — /) print "- " label
    }
  ' "$grounding")"
  if [ -n "$non_floor" ]; then
    echo "routine-approve: unanswered operator questions block the proceed:" >&2
    printf '%s\n' "$non_floor" >&2
    exit 1
  fi
fi

if [ -n "$note" ]; then
  {
    printf '## %s\n\n%s\n\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$note"
  } >> "$ticket/approve.md"
fi

telemetry_emit "$ticket/telemetry.jsonl" ticket.approve bin/routine-approve \
  "$(basename "$ticket")" "" 0 "$(( $(routine_now_ms) - start_ms ))"
echo "routine-approve: recorded"
exit 0
