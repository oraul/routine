#!/usr/bin/env bash
# Dependency discovery: read the target's manifests and print one caffeine
# topic per line (ruby/<gem>, js/<package>, python/<package>). Extraction is
# grep/awk only — drafting best practices is the /caffeinate skill's job.
set -u

# shellcheck source=/dev/null
. "$(cd "$(dirname "$0")/.." && pwd)/lib/paths.sh"
# shellcheck source=/dev/null
. "$(cd "$(dirname "$0")/.." && pwd)/lib/telemetry.sh"

start_ms="$(routine_now_ms)"

root="$(routine_root)"
target="${TARGET:-$PWD}"
app="$(routine_app_key "$target")"

# Evidence only where a destination exists: without scaffolded app state
# there is nowhere to write, and scripts never invent a destination.
emit() {
  [ -d "$root/runs/$app" ] || return 0
  telemetry_emit "$root/runs/$app/telemetry.jsonl" app.deps bin/routine-deps \
    "" "" "$1" "$(( $(routine_now_ms) - start_ms ))"
}

# Canonicalization: discovery output maps through caffeine/aliases.tsv
# (<emitted> TAB <topic> [<topic>...]) so package spellings land on real
# topics and implied topics ride along; unknown names pass through.
canonicalize() {
  if [ -f "$root/caffeine/aliases.tsv" ]; then
    awk -F'\t' '
      NR == FNR { if (NF >= 2) map[$1] = $2; next }
      {
        if ($0 in map) {
          n = split(map[$0], t, " ")
          for (i = 1; i <= n; i++) print t[i]
        } else print
      }
    ' "$root/caffeine/aliases.tsv" -
  else
    cat
  fi
}

discover() {
if [ -f "$target/Gemfile" ]; then
  awk '/^[[:space:]]*gem[[:space:]]+["'\'']/ {
         line = $0
         sub(/^[[:space:]]*gem[[:space:]]+["'\'']/, "", line)
         sub(/["'\''].*$/, "", line)
         if (line != "") print "ruby/" line
       }' "$target/Gemfile"
fi

if [ -f "$target/package.json" ]; then
  awk -F'"' '
    /"(dependencies|devDependencies)"[[:space:]]*:/ { indeps = 1; next }
    indeps && /}/ { indeps = 0 }
    indeps && NF >= 2 && $2 != "" { print "js/" $2 }
  ' "$target/package.json"
fi

if [ -f "$target/requirements.txt" ]; then
  awk '/^[[:space:]]*[A-Za-z0-9]/ {
         line = $0
         sub(/[<>=!~;[:space:]\[].*$/, "", line)
         if (line != "") print "python/" tolower(line)
       }' "$target/requirements.txt"
fi

}

if [ ! -f "$target/Gemfile" ] && [ ! -f "$target/package.json" ] \
  && [ ! -f "$target/requirements.txt" ]; then
  echo "routine-deps: no manifest found in $target (looked for Gemfile, package.json, requirements.txt)" >&2
  emit 1
  exit 1
fi

discover | canonicalize
emit 0
exit 0
