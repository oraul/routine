#!/usr/bin/env bash
# Marks the single in_progress task done. WIP = 1 makes the target
# unambiguous; there is nothing to choose.
set -u

lib="$(cd "$(dirname "$0")/.." && pwd)/lib"
# shellcheck source=/dev/null
. "$lib/telemetry.sh"
# shellcheck source=/dev/null
. "$lib/index.sh"

ticket="${1:-}"
if [ ! -d "$ticket" ] || [ ! -f "$ticket/index.tsv" ]; then
  echo "usage: routine-done <ticket-dir>" >&2
  exit 2
fi

if ! row="$(index_first_with_status "$ticket/index.tsv" in_progress)"; then
  echo "routine-done: no task is in_progress" >&2
  exit 1
fi
tid="$(printf '%s' "$row" | cut -f1)"
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

index_set_status "$ticket/index.tsv" "$tid" "done" "$ts"
telemetry_emit "$ticket/telemetry.jsonl" ticket.done bin/routine-done \
  "$(basename "$ticket")" "$tid" 0 0
echo "routine-done: $tid done"
exit 0
