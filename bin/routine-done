#!/usr/bin/env bash
# routine-script: routine-done
# routine-description: Mark the in_progress task done after its developer gate passed
# routine-usage: routine-done <ticket-dir>
# routine-exit: 0 — done — status flipped, ticket.done recorded
# routine-exit: 1 — refused — no in_progress task or no passing gate on record
# routine-exit: 2 — usage
# routine-test: test/lifecycle.bats
# Marks the single in_progress task done. WIP = 1 makes the target
# unambiguous; there is nothing to choose.
set -u

lib="$(cd "$(dirname "$0")/.." && pwd)/lib"
# shellcheck source=/dev/null
. "$lib/telemetry.sh"
# shellcheck source=/dev/null
. "$lib/index.sh"

start_ms="$(routine_now_ms)"

ticket="${1:-}"
if [ ! -d "$ticket" ] || [ ! -f "$ticket/index.tsv" ]; then
  echo "usage: routine-done <ticket-dir>" >&2
  exit 2
fi

if ! row="$(index_first_with_status "$ticket/index.tsv" in_progress)"; then
  echo "routine-done: no task is in_progress" >&2
  telemetry_emit "$ticket/telemetry.jsonl" ticket.done bin/routine-done \
    "$(basename "$ticket")" "" 1 "$(( $(routine_now_ms) - start_ms ))"
  exit 1
fi
tid="$(printf '%s' "$row" | cut -f1)"
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

index_set_status "$ticket/index.tsv" "$tid" "done" "$ts"
telemetry_emit "$ticket/telemetry.jsonl" ticket.done bin/routine-done \
  "$(basename "$ticket")" "$tid" 0 "$(( $(routine_now_ms) - start_ms ))"
echo "routine-done: $tid done"
exit 0
