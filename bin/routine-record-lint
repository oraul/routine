#!/usr/bin/env bash
# routine-script: routine-record-lint
# routine-description: A release record's form as exit codes — both sections present, no section silently empty, every entry evidenced, every cited #NNN in the record's own range, and the one check that catches a false Caffeine claim
# routine-usage: routine-record-lint <file>
# routine-exit: 0 — the record is well-formed
# routine-exit: 1 — violations found — each names the file and the rule
# routine-exit: 2 — usage — no file argument, or the named file does not exist
# routine-test: test/record_lint.bats
# Two sections, because routine has exactly two mechanisms: Caffeine is
# knowledge loaded into future work, Gate is a decision made by an exit
# code. Form checks only, pure grep/awk: both sections present, no
# section left silently empty (the '- none — <why>' floor applies), and
# every entry carries an 'evidence:' line. One clause catches a false
# claim rather than a malformed one: a Caffeine entry naming
# 'topic: <ns>/<name>' must resolve to a real caffeine/<ns>/<name>.{sh,md}
# pair, reusing the resolver routine-spec-lint applies to task manifests
# (lib/caffeine.sh) rather than growing a second implementation. One
# more clause reads git rather than the file alone: every '#NNN' cited
# anywhere in the record must resolve to a merge in the record's own
# range, derived from the filename's tag and the previous tag the same
# way routine-release-notes derives it. The range can be established
# only when the filename names a tag, a previous tag exists, and there
# is git history to read; when it cannot, the rule is skipped rather
# than violated (Law 7's posture toward an absent layer), which is what
# keeps a fixture with no repository, and a draft record before its tag
# exists, still lintable. Whether a lesson is true, its evidence sound,
# or a section honest: no script here can decide that.
set -u

# shellcheck source=/dev/null
. "$(cd "$(dirname "$0")/.." && pwd)/lib/paths.sh"
# shellcheck source=/dev/null
. "$(cd "$(dirname "$0")/.." && pwd)/lib/caffeine.sh"

file="${1:-}"
if [ -z "$file" ] || [ ! -f "$file" ]; then
  echo "usage: routine-record-lint <file>" >&2
  exit 2
fi

caffeine_root="$(routine_root)/caffeine"

fails=0
fail() { echo "record-lint: $1: $2" >&2; fails=$((fails + 1)); }

_rl_tab="$(printf '\t')"

for _rl_sec in Caffeine Gate; do
  if ! grep -q "^## $_rl_sec" "$file"; then
    fail "$file" "missing '## $_rl_sec' section"
    continue
  fi

  if ! awk -v s="$_rl_sec" '$0 ~ "^## " s {a=1; next} a && /^#/ {a=0} a && /^- / {found=1} END {exit !found}' "$file"; then
    fail "$file" "'## $_rl_sec' is empty — record at least one entry, or '- none — <why nothing qualifies>'"
    continue
  fi

  # One line per entry: label, whether an 'evidence:' line was seen, the
  # 'none' floor flag, and the 'topic:' value if any. A new top-level
  # bullet ('- ' at column 0) starts an entry; every other non-blank line
  # in the section is a field of the entry above it.
  _rl_entries="$(awk -v s="$_rl_sec" '
    $0 ~ "^## " s { insec=1; next }
    insec && /^#/ { insec=0 }
    insec && /^- / {
      if (label != "") print label "\t" has_ev "\t" is_floor "\t" topic
      label = $0
      sub(/^- /, "", label)
      has_ev = 0
      topic = ""
      is_floor = (label ~ /^none — /) ? 1 : 0
      next
    }
    insec && NF {
      line = $0
      sub(/^[ \t]+/, "", line)
      if (line ~ /^evidence: .+/) has_ev = 1
      if (line ~ /^topic: /) { t = line; sub(/^topic: /, "", t); topic = t }
    }
    END { if (label != "") print label "\t" has_ev "\t" is_floor "\t" topic }
  ' "$file")"

  while IFS="$_rl_tab" read -r _rl_label _rl_has_ev _rl_is_floor _rl_topic; do
    [ -n "$_rl_label" ] || continue
    if [ "$_rl_is_floor" != 1 ] && [ "$_rl_has_ev" != 1 ]; then
      fail "$file" "'## $_rl_sec' entry '$_rl_label' has no evidence: line"
    fi
    if [ "$_rl_sec" = Caffeine ] && [ "$_rl_is_floor" != 1 ] && [ -n "$_rl_topic" ]; then
      if ! caffeine_topic_resolves "$caffeine_root" "$_rl_topic"; then
        _rl_available="$(caffeine_topic_list "$caffeine_root")"
        fail "$file" "Caffeine entry '$_rl_label' names topic '$_rl_topic' which resolves to no caffeine/$_rl_topic.{sh,md}; available topics: ${_rl_available:-none}"
      fi
    fi
  done <<EOF
$_rl_entries
EOF
done

# Citation provenance: every #NNN cited anywhere in a Caffeine or Gate
# entry must resolve to a merge in this record's own range. The range
# comes from the record's own filename (its tag) and the previous tag,
# derived the way routine-release-notes derives it. Any of: the
# filename names no tag, there is no git history to read, or there is
# no previous tag (the first release) — and the rule is skipped rather
# than failed, never manufacturing a violation from an absent layer.
_rl_tag="$(basename "$file")"
_rl_tag="${_rl_tag%.md}"
_rl_repo="$(dirname "$file")"
if printf '%s' "$_rl_tag" | grep -Eq '^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$' \
  && git -C "$_rl_repo" rev-parse --git-dir >/dev/null 2>&1; then
  if git -C "$_rl_repo" rev-parse -q --verify "refs/tags/$_rl_tag" >/dev/null; then
    _rl_end="$_rl_tag"
  else
    _rl_end="HEAD"
  fi
  _rl_prev="$(git -C "$_rl_repo" describe --tags --abbrev=0 --exclude "$_rl_tag" "$_rl_end" 2>/dev/null || true)"
  if [ -n "$_rl_prev" ]; then
    _rl_allowed="$(git -C "$_rl_repo" log "$_rl_prev..$_rl_end" --merges --first-parent --format='%s' \
      | grep -Eo 'pull request #[0-9]+:' | grep -Eo '[0-9]+')"

    # Same entry shape as the section loop above, but spanning both
    # sections at once: label plus every line of the entry's body,
    # joined, so a citation anywhere in the entry is found.
    _rl_cited="$(awk '
      /^## Caffeine/ || /^## Gate/ { insec = 1; next }
      insec && /^#/ { insec = 0 }
      insec && /^- / {
        if (label != "") print label "\t" body
        label = $0
        sub(/^- /, "", label)
        body = label
        next
      }
      insec && NF {
        line = $0
        sub(/^[ \t]+/, "", line)
        body = body " " line
      }
      END { if (label != "") print label "\t" body }
    ' "$file")"

    while IFS="$_rl_tab" read -r _rl_c_label _rl_c_body; do
      [ -n "$_rl_c_label" ] || continue
      for _rl_num in $(printf '%s' "$_rl_c_body" | grep -Eo '#[0-9]+' | grep -Eo '[0-9]+'); do
        if ! printf '%s\n' "$_rl_allowed" | grep -qx "$_rl_num"; then
          fail "$file" "entry '$_rl_c_label' cites #$_rl_num which is not a merge in ${_rl_prev}..${_rl_end}"
        fi
      done
    done <<EOF
$_rl_cited
EOF
  fi
fi

# The spot-check sample: one non-floor entry named per run across both
# sections, chosen by the record's own bytes so the author never picks
# which claim gets re-run. Reported, never gating — a curated record
# survives only where nothing is ever re-run. The floor exclusion uses
# index(), keeping the em-dash out of any regex engine.
_sc_entries="$(awk '/^## Caffeine$/ || /^## Gate$/ {a=1; next}
  /^## / {a=0}
  a && /^- / { if (index($0, "- none — ") != 1) print }' "$file")"
if [ -n "$_sc_entries" ]; then
  _sc_n="$(printf '%s\n' "$_sc_entries" | wc -l | tr -d ' ')"
  _sc_idx=$(( $(cksum < "$file" | awk '{print $1}') % _sc_n + 1 ))
  _sc_entry="$(printf '%s\n' "$_sc_entries" | awk -v n="$_sc_idx" 'NR == n')"
  echo "record-lint: spot-check — re-run this entry's evidence before publishing: $_sc_entry"
fi

if [ "$fails" -gt 0 ]; then
  echo "record-lint: $fails violation(s)" >&2
  exit 1
fi
echo "record-lint: ok"
exit 0
