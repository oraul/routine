#!/usr/bin/env bash
# routine-script: routine-release-check
# routine-description: The release gate: a tag may be cut only when every mechanical condition holds
# routine-usage: routine-release-check vX.Y.Z (a well-formed semver tag)
# routine-exit: 0 — releasable
# routine-exit: 1 — a release condition failed — the output names it
# routine-exit: 2 — usage — a well-formed semver tag is required
# routine-test: test/release_check.bats
# The release gate: a tag may be cut only when every mechanically checkable
# release condition holds. Patch-vs-minor judgment stays with the human;
# everything else is enforced here.
set -u

# shellcheck source=/dev/null
. "$(cd "$(dirname "$0")/.." && pwd)/lib/paths.sh"
# shellcheck source=/dev/null
. "$(cd "$(dirname "$0")/.." && pwd)/lib/telemetry.sh"

start_ms="$(routine_now_ms)"

root="$(routine_root)"
tag="${1:-}"

# Verdict first, evidence on the way out; usage errors stay silent.
finish() {
  telemetry_harness_emit harness.release bin/routine-release-check "$1" \
    "$(( $(routine_now_ms) - start_ms ))"
  exit "$1"
}

if ! printf '%s' "$tag" | grep -Eq '^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'; then
  echo "usage: routine-release-check vX.Y.Z (a well-formed semver tag)" >&2
  exit 2
fi
version="${tag#v}"

manifest="$root/.claude-plugin/plugin.json"
if [ ! -f "$manifest" ]; then
  echo "routine-release-check: no plugin manifest at $manifest" >&2
  finish 1
fi
declared="$(awk -F'"' '/"version"/ {print $4; exit}' "$manifest")"
if [ "$declared" != "$version" ]; then
  echo "routine-release-check: tag says $version but plugin.json declares $declared" >&2
  finish 1
fi

branch="$(git -C "$root" symbolic-ref --short -q HEAD || true)"
if [ "$branch" != "main" ]; then
  echo "routine-release-check: releases are cut from main (currently: ${branch:-detached})" >&2
  finish 1
fi

if [ -n "$(git -C "$root" status --porcelain)" ]; then
  echo "routine-release-check: worktree is not clean" >&2
  git -C "$root" status --short >&2
  finish 1
fi

record="$root/evidence/$tag.md"
if [ ! -f "$record" ]; then
  echo "routine-release-check: no release record at evidence/$tag.md" >&2
  finish 1
fi
if ! lint_out="$("$(cd "$(dirname "$0")" && pwd)/routine-record-lint" "$record" 2>&1)"; then
  echo "routine-release-check: release record rejected" >&2
  printf '%s\n' "$lint_out" >&2
  finish 1
fi

# Renders are judged before the suite runs, because a stale render is
# cheap to detect and the answer does not depend on the suite. The
# comparison itself is not restated here: routine-render-check owns it
# and this gate relays its verdict, the same relay the record lint gets.
renders=()
for candidate in "$root"/evidence/*; do
  [ -f "$candidate" ] || continue
  renders[${#renders[@]}]="$candidate"
done
if [ "${#renders[@]}" -gt 0 ]; then
  render_status=0
  render_out="$("$(cd "$(dirname "$0")" && pwd)/routine-render-check" \
    "${renders[@]}" 2>&1)" || render_status=$?
  [ -n "$render_out" ] && printf '%s\n' "$render_out"
  if [ "$render_status" -ne 0 ]; then
    echo "routine-release-check: a committed render is not current" >&2
    finish 1
  fi
fi

if ! "$root/bin/routine-selfcheck"; then
  echo "routine-release-check: selfcheck is red" >&2
  finish 1
fi

echo "routine-release-check: $tag is releasable"
finish 0
