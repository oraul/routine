+
+  def test_the_review_threshold_is_judged_on_the_discounted_cost
+    order = Order.new.add_item("mug", 1200).add_item("beans", 1850)
+    order.apply_discount(10)
+    assert_equal 2745, order.total_cents
+    result = order.confirm!(review_threshold_cents: 3000)
+    assert_same order, result
+    assert_equal :confirmed, order.status
+    assert_equal 2745, order.total_cents
+  end
+
+  def test_applying_a_discount_after_confirmation_is_refused_and_the_confirmed_cost_stands
+    order = Order.new.add_item("mug", 1200).add_item("beans", 1850).confirm!
+    assert_equal :confirmed, order.status
+    assert_equal 3050, order.total_cents
+    error = assert_raises(FrozenError) { order.apply_discount(10) }
