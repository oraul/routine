@@ -33,6 +33,10 @@ class Order
     @status = review_threshold_cents && total_cents > review_threshold_cents ? :needs_review : :confirmed
     @items.each(&:freeze)
     @items.freeze
+    # A confirmed order is done, not merely done growing. Two incidents
+    # came from state written onto an order after it settled, so the
+    # object itself is sealed and not just its line items.
+    freeze
     self
   end
 end
diff --git a/test/order_test.rb b/test/order_test.rb
index dd68802..f95bead 100644
--- a/test/order_test.rb
