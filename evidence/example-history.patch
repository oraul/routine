+  end
+
+  def test_removing_an_item_after_confirmation_is_refused_and_the_confirmed_contents_stand
+    order = Order.new.add_item("mug", 1200).add_item("beans", 1850)
+    order.confirm!
+    error = assert_raises(FrozenError) { order.remove_item("mug") }
+    assert_equal "order is settled", error.message
+    assert_equal :confirmed, order.status
+    assert_equal [{ name: "mug", price_cents: 1200 }, { name: "beans", price_cents: 1850 }], order.items
+    assert_equal 3050, order.total_cents
+  end
+
+  def test_removing_an_item_from_an_order_flagged_for_review_is_refused_and_the_reviewed_contents_stand
+    order = Order.new.add_item("mug", 1200).add_item("beans", 1850)
+    order.confirm!(review_threshold_cents: 3000)
