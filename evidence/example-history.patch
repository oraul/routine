Subject: [PATCH 5/9] removing a line item from a pending order

remove_item(name) drops the earliest copy of a name, refuses an unknown
name with ArgumentError, and refuses any removal once the order is
settled with the same FrozenError message add_item raises. An emptied
order stays pending and usable; pricing it is refused the way any empty
order's pricing is.
---
 lib/order.rb       |  8 ++++++
 test/order_test.rb | 65 ++++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 73 insertions(+)

diff --git a/lib/order.rb b/lib/order.rb
index 9b9f3e9..eddb0f4 100644
--- a/lib/order.rb
+++ b/lib/order.rb
@@ -14,6 +14,14 @@ class Order
     self
   end
 
+  def remove_item(name)
+    raise FrozenError, "order is settled" unless @status == :pending
+    index = @items.index { |i| i[:name] == name }
+    raise ArgumentError, "no line item named #{name}" unless index
+    @items.delete_at(index)
+    self
+  end
+
   # An order with nothing in it is not a zero-value order, it is a
   # mistake: pricing an empty basket has burned us twice in reporting.
   def total_cents
diff --git a/test/order_test.rb b/test/order_test.rb
index b53cbed..dd68802 100644
--- a/test/order_test.rb
+++ b/test/order_test.rb
@@ -93,4 +93,69 @@ class OrderTest < Minitest::Test
     order = Order.new
     assert_raises(ArgumentError) { order.total_cents }
   end
+
+  def test_a_pending_orders_total_is_recomputed_from_its_current_item_list
+    order = Order.new.add_item("mug", 1200).add_item("beans", 1850)
+    assert_equal 3050, order.total_cents
+    order.items.pop
+    assert_equal [{ name: "mug", price_cents: 1200 }], order.items
+    assert_equal 1200, order.total_cents
+  end
+
+  def test_removing_an_item_lowers_the_total_by_that_items_price
+    order = Order.new.add_item("mug", 1200).add_item("beans", 1850)
+    result = order.remove_item("beans")
+    assert_same order, result
+    assert_equal [{ name: "mug", price_cents: 1200 }], order.items
+    assert_equal 1200, order.total_cents
+    assert_equal :pending, order.status
+  end
+
+  def test_removing_a_repeated_name_drops_exactly_one_copy
+    order = Order.new.add_item("mug", 1200).add_item("beans", 1850).add_item("mug", 1200)
+    result = order.remove_item("mug")
+    assert_same order, result
+    assert_equal [{ name: "beans", price_cents: 1850 }, { name: "mug", price_cents: 1200 }], order.items
+    assert_equal 3050, order.total_cents
+  end
+
+  def test_removing_the_last_remaining_item_empties_the_order_and_leaves_it_refusing_to_price_itself
+    order = Order.new.add_item("mug", 1200)
+    order.remove_item("mug")
+    assert_empty order.items
+    assert_equal :pending, order.status
+    assert_raises(ArgumentError) { order.total_cents }
+    order.add_item("beans", 1850)
+    assert_equal 1850, order.total_cents
+    result = order.confirm!
+    assert_equal :confirmed, result.status
+  end
+
+  def test_removing_a_name_the_order_does_not_hold_is_refused_and_the_order_stands
+    order = Order.new.add_item("mug", 1200).add_item("beans", 1850)
+    assert_raises(ArgumentError) { order.remove_item("rug") }
+    assert_equal [{ name: "mug", price_cents: 1200 }, { name: "beans", price_cents: 1850 }], order.items
+    assert_equal 3050, order.total_cents
