From 735815cf04ee30412c25ea5b9d17fb8d45d35b34 Mon Sep 17 00:00:00 2001
From: shopapp <shopapp@example.invalid>
Date: Tue, 25 Aug 2026 04:22:58 +0000
Subject: [PATCH 7/9] applying a percentage discount to a pending order
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

apply_discount(percent) guards settlement first with the same
FrozenError message add_item raises, then the range — a whole number
from 1 to 100 — and appends to an ordered list. total_cents folds the
sum through each discount in turn, integer division scaling what
remains, so fractions of a cent go to the customer and successive
discounts compound. The review threshold judges the discounted cost
with no edit to confirm!.
---
 lib/order.rb       |  11 ++++-
 test/order_test.rb | 113 +++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 123 insertions(+), 1 deletion(-)

diff --git a/lib/order.rb b/lib/order.rb
index 2726a7c..8a70a65 100644
--- a/lib/order.rb
+++ b/lib/order.rb
@@ -5,6 +5,7 @@ class Order
   def initialize
     @items = []
     @status = :pending
+    @discounts = []
   end
 
   def add_item(name, price_cents)
@@ -26,7 +27,15 @@ class Order
   # mistake: pricing an empty basket has burned us twice in reporting.
   def total_cents
     raise ArgumentError, "order has no items" if @items.empty?
-    @items.sum { |i| i[:price_cents] }
+    sum = @items.sum { |i| i[:price_cents] }
+    @discounts.reduce(sum) { |cost, percent| cost * (100 - percent) / 100 }
+  end
+
+  def apply_discount(percent)
+    raise FrozenError, "order is settled" unless @status == :pending
+    raise ArgumentError, "percent must be a whole number between 1 and 100" unless percent.is_a?(Integer) && percent.between?(1, 100)
+    @discounts << percent
+    self
   end
 
   def confirm!(review_threshold_cents: nil)
diff --git a/test/order_test.rb b/test/order_test.rb
index f95bead..f2b09e8 100644
--- a/test/order_test.rb
+++ b/test/order_test.rb
@@ -163,4 +163,117 @@ class OrderTest < Minitest::Test
     order = Order.new.add_item("mug", 1200).confirm!
     assert_predicate order, :frozen?
   end
+
+  def test_settlement_seals_the_order_and_the_settled_refusal_is_a_guard_with_its_own_message
+    order = Order.new.add_item("mug", 1200).add_item("beans", 1850).confirm!
+    assert_equal :confirmed, order.status
+    assert_equal 3050, order.total_cents
+    assert_predicate order, :frozen?
+    assert_predicate order.items, :frozen?
+    assert_predicate order.items.first, :frozen?
+    error = assert_raises(FrozenError) { order.add_item("rug", 9000) }
+    assert_equal "order is settled", error.message
+    assert_equal :confirmed, order.status
+    assert_equal [{ name: "mug", price_cents: 1200 }, { name: "beans", price_cents: 1850 }], order.items
+    assert_equal 3050, order.total_cents
+  end
+
+  def test_applying_a_discount_lowers_the_orders_cost_by_that_percentage
+    order = Order.new.add_item("mug", 1200).add_item("beans", 1850)
+    assert_equal 3050, order.total_cents
+    result = order.apply_discount(10)
+    assert_same order, result
+    assert_equal 2745, order.total_cents
+    assert_equal :pending, order.status
+    assert_equal [{ name: "mug", price_cents: 1200 }, { name: "beans", price_cents: 1850 }], order.items
+  end
+
+  def test_an_item_added_after_a_discount_is_discounted_with_the_rest
+    order = Order.new.add_item("mug", 1200)
+    order.apply_discount(10)
+    assert_equal 1080, order.total_cents
+    order.add_item("beans", 1850)
+    assert_equal 2745, order.total_cents
+    assert_equal [{ name: "mug", price_cents: 1200 }, { name: "beans", price_cents: 1850 }], order.items
+  end
+
+  def test_a_discount_that_does_not_divide_evenly_leaves_the_cost_in_whole_cents
+    order = Order.new.add_item("mug", 1200).add_item("beans", 1850)
+    order.apply_discount(33)
