 # A minimal order: line items with prices, a computed total, a status.
 class Order
+  # The receipt's shape: immutable value objects, immutable all the way
+  # down — each line is itself a frozen Data instance.
+  Line = Data.define(:name, :unit_price_cents, :quantity, :line_total_cents)
+  Receipt = Data.define(:lines, :discount_percents, :total_cents)
+
   attr_reader :items, :status
 
   def initialize
@@ -8,10 +13,13 @@ class Order
     @discounts = []
   end
 
-  def add_item(name, price_cents)
+  def add_item(name, price_cents, quantity: 1)
     raise FrozenError, "order is settled" unless @status == :pending
     raise ArgumentError, "price must be positive" unless price_cents.positive?
-    @items << { name: name, price_cents: price_cents }
+    raise ArgumentError, "quantity must be a positive whole number" unless quantity.is_a?(Integer) && quantity.positive?
+    line = { name: name, price_cents: price_cents }
+    line[:quantity] = quantity unless quantity == 1
+    @items << line
     self
   end
 
@@ -27,10 +35,24 @@ class Order
   # mistake: pricing an empty basket has burned us twice in reporting.
   def total_cents
     raise ArgumentError, "order has no items" if @items.empty?
-    sum = @items.sum { |i| i[:price_cents] }
+    sum = @items.sum { |i| i[:price_cents] * i.fetch(:quantity, 1) }
     @discounts.reduce(sum) { |cost, percent| cost * (100 - percent) / 100 }
   end
 
+  # The order's account of itself, in total_cents's image: derived on
+  # every call, nothing stored, nothing memoized. Line totals are
+  # undiscounted; discounts apply at order level, in application order.
+  def receipt
+    total = total_cents # an empty basket refuses to price itself
+    lines = @items.map do |i|
+      quantity = i.fetch(:quantity, 1)
+      Line.new(name: i[:name], unit_price_cents: i[:price_cents],
+               quantity: quantity, line_total_cents: i[:price_cents] * quantity)
+    end.freeze
+    Receipt.new(lines: lines, discount_percents: @discounts.dup.freeze,
+                total_cents: total)
+  end
+
   def apply_discount(percent)
     raise FrozenError, "order is settled" unless @status == :pending
     raise ArgumentError, "percent must be a whole number between 1 and 100" unless percent.is_a?(Integer) && percent.between?(1, 100)
