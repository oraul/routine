From 132ad46b0aff664c619fa4e0da895c94b79bf382 Mon Sep 17 00:00:00 2001
From: shopapp <shopapp@example.invalid>
Date: Sat, 15 Aug 2026 06:17:45 +0000
Subject: [PATCH 1/9] order model with items, total, and confirmation

---
 lib/order.rb       | 24 ++++++++++++++++++++++++
 test/order_test.rb | 23 +++++++++++++++++++++++
 2 files changed, 47 insertions(+)
 create mode 100644 lib/order.rb
 create mode 100644 test/order_test.rb

diff --git a/lib/order.rb b/lib/order.rb
new file mode 100644
index 0000000..3493a2f
--- /dev/null
+++ b/lib/order.rb
@@ -0,0 +1,24 @@
+# A minimal order: line items with prices, a computed total, a status.
+class Order
+  attr_reader :items, :status
+
+  def initialize
+    @items = []
+    @status = :pending
+  end
+
+  def add_item(name, price_cents)
+    raise ArgumentError, "price must be positive" unless price_cents.positive?
+    @items << { name: name, price_cents: price_cents }
+    self
+  end
+
+  def total_cents
+    @items.sum { |i| i[:price_cents] }
+  end
+
+  def confirm!
+    @status = :confirmed
+    self
+  end
+end
diff --git a/test/order_test.rb b/test/order_test.rb
new file mode 100644
index 0000000..5312d08
--- /dev/null
+++ b/test/order_test.rb
@@ -0,0 +1,23 @@
+require "minitest/autorun"
+require_relative "../lib/order"
+
+class OrderTest < Minitest::Test
+  def test_a_new_order_is_pending_and_empty
+    order = Order.new
+    assert_equal :pending, order.status
+    assert_equal 0, order.total_cents
+  end
+
+  def test_the_total_sums_item_prices
+    order = Order.new.add_item("mug", 1200).add_item("beans", 1850)
+    assert_equal 3050, order.total_cents
+  end
+
+  def test_a_non_positive_price_is_refused
+    assert_raises(ArgumentError) { Order.new.add_item("free", 0) }
+  end
+
+  def test_confirming_moves_the_status
+    assert_equal :confirmed, Order.new.confirm!.status
+  end
+end
-- 
